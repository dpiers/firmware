# Single-block native SD PIO; both MMC controller nodes remain disabled.
CONFIG_BLOCK=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_NT98513=y
CONFIG_NT98513_MMC_BOARD=y
# CONFIG_MMC_SDHCI is not set
# CONFIG_MMC_SPI is not set
# CONFIG_MMC_TEST is not set
# CONFIG_PM is not set
# CONFIG_OF_DYNAMIC is not set
