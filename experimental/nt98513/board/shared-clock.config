CONFIG_COMMON_CLK=y
# CONFIG_NT98513_WATCHDOG is not set
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=0
# CONFIG_SMP is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_OF_DYNAMIC is not set
CONFIG_NT98513_SHARED_CLOCK_BOARD=y
CONFIG_NT98513_SHARED_CLOCK=y
CONFIG_NT98513_WATCHDOG_SHARED=y
CONFIG_NT98513_CC_BANK=y
CONFIG_GPIO_NT98513=y
CONFIG_GPIOLIB=y
CONFIG_OF_GPIO=y
CONFIG_GPIO_CDEV=y
# CONFIG_GPIO_CDEV_V1 is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_PINCTRL is not set
