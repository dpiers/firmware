BR2_mipsel=y
BR2_mips_32r2=y
BR2_MIPS_SOFT_FLOAT=y
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_VENDOR="openipc"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_GCC_VERSION_12_X=y
BR2_BINUTILS_VERSION_2_41_X=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_STATIC_LIBS=y
BR2_OPTIMIZE_S=y
BR2_REPRODUCIBLE=y
BR2_CCACHE=n
BR2_DL_DIR="/work/dl"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_DEVICE_TABLE=""
BR2_ROOTFS_STATIC_DEVICE_TABLE="$(BR2_EXTERNAL_NT98513_PATH)/board/devices.txt"
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="$(BR2_EXTERNAL_NT98513_PATH)/board/rootfs"
BR2_TARGET_GENERIC_HOSTNAME="openipc-nt98513-ram"
BR2_TARGET_GENERIC_ISSUE="Experimental OpenIPC NT98513 RAM console"
# BR2_TARGET_GENERIC_GETTY is not set
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_NT98513_PATH)/board/busybox.config"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="file:///inputs/linux-6.6.158.tar.xz"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_NT98513_PATH)/patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_NT98513_PATH)/board/linux.config"
BR2_LINUX_KERNEL_VMLINUX_BIN=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_FULL=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_JLEVEL=4
BR2_WGET="wget --passive-ftp -nd -t 2 -T 20"
BR2_BACKUP_SITE="https://sources.buildroot.net"

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_NT98513_PATH)/board/overlay"

BR2_TAR_OPTIONS="--no-same-owner"

# BR2_PACKAGE_URANDOM_SCRIPTS is not set

BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_NT98513_PATH)/board/normalize-rootfs.py"

# Experimental complete shared-clock board; no consumer or auto-service.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_NT98513_PATH)/board/shared-clock.config"
