--- /dev/null
+++ b/drivers/clk/nt98513-shared/driver/nt98513_mmc_clock.c
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/slab.h>
+#include <linux/soc/nt98513_mmc_clock.h>
+#include "nt98513_clock_private.h"
+
+/* No second CG/CC owner: every operation holds the permanent owner's mutex.
+ * Each hardware transaction also uses the existing CC-bank resource2. Claims
+ * serialize Linux clients only; firmware/DMA quiescence is a board obligation.
+ */
+struct nt98513_mmc_clock {
+ struct nt98513_clock_owner *owner;
+ unsigned index;
+};
+enum nt_mmc_reg { MMC_GATE, MMC_PREPARE, MMC_MUX, MMC_DIVIDER, MMC_PHASE };
+
+static struct nt_mmc_state *mmc_state(struct nt98513_mmc_clock *c)
+{
+ return &c->owner->mmc[c->index];
+}
+static void __iomem *mmc_reg(struct nt98513_clock_owner *o, unsigned r)
+{
+ switch (r) {
+ case MMC_GATE: return o->gate;
+ case MMC_PREPARE: return o->prepare;
+ case MMC_MUX: return o->mux;
+ case MMC_DIVIDER: return o->divider;
+ default: return o->phase;
+ }
+}
+static unsigned mmc_mask(struct nt98513_mmc_clock *c, unsigned r)
+{
+ switch (r) {
+ case MMC_GATE:
+ case MMC_PREPARE: return 1U << (2 + c->index);
+ case MMC_MUX: return 3U << (c->index ? 8 : 4);
+ case MMC_DIVIDER: return 2047U << (c->index ? 16 : 0);
+ default: return 1U << (20 + c->index);
+ }
+}
+static int mmc_latch(struct nt98513_mmc_clock *c, int error)
+{
+ struct nt_mmc_state *s = mmc_state(c);
+ if (error && !s->fault) s->fault = error;
+ return error;
+}
+static int mmc_health(struct nt98513_mmc_clock *c)
+{
+ int error = mmc_state(c)->fault;
+ return error ? error : nt98513_clock_fault(c->owner);
+}
+/* Called only while resource2 is granted. Unowned fields may legitimately
+ * change between transactions; owned fields must equal our last verified state.
+ */
+static int mmc_validate(struct nt98513_mmc_clock *c, bool admission)
+{
+ struct nt_mmc_state *s = mmc_state(c);
+ unsigned r, v, mask;
+ for (r = 0; r < 5; r++) {
+  mask = mmc_mask(c, r);
+  v = readl(mmc_reg(c->owner, r));
+  if (v == ~0U) return -EIO;
+  if (r == MMC_MUX && (v & mask)) return -EIO; /* fixed192m only */
+  if (admission) {
+   if ((r == MMC_GATE || r == MMC_PREPARE) && !(v & mask)) return -EIO;
+   s->expected[r] = v & mask;
+  } else if ((v & mask) != s->expected[r]) {
+   return -EIO;
+  }
+ }
+ return 0;
+}
+static int mmc_begin(struct nt98513_mmc_clock *c, bool admission)
+{
+ struct nt98513_cc_bank *bank = c->owner->bank;
+ int error = mmc_health(c);
+ if (error) return mmc_latch(c, error);
+ error = nt_cc_enter(bank, 2);
+ if (error) return mmc_latch(c, error);
+ error = nt_cc_acquire_locked(bank, 2);
+ if (error) {
+  /* The bank deliberately does not release an uncertain acquisition. */
+  nt_cc_leave(bank);
+  return mmc_latch(c, error);
+ }
+ error = mmc_validate(c, admission);
+ if (error) {
+  int released = nt_cc_release_locked(bank, 2);
+  nt_cc_leave(bank);
+  return mmc_latch(c, error ? error : released);
+ }
+ return 0;
+}
+static int mmc_end(struct nt98513_mmc_clock *c, int error)
+{
+ int released = nt_cc_release_locked(c->owner->bank, 2);
+ nt_cc_leave(c->owner->bank);
+ return mmc_latch(c, error ? error : released);
+}
+static int mmc_update(struct nt98513_mmc_clock *c, unsigned reg, unsigned bits)
+{
+ struct nt_mmc_state *s = mmc_state(c);
+ unsigned mask = mmc_mask(c, reg);
+ unsigned old = readl(mmc_reg(c->owner, reg)), value;
+ if (old == ~0U || (old & mask) != s->expected[reg]) return -EIO;
+ value = (old & ~mask) | (bits & mask);
+ if (value == ~0U) return -EIO;
+ if (old != value) writel(value, mmc_reg(c->owner, reg));
+ /* Verify the full word while arbitrated, including preserved sibling bits. */
+ if (readl(mmc_reg(c->owner, reg)) != value) return -EIO;
+ s->expected[reg] = value & mask;
+ return 0;
+}
+static int mmc_set(struct nt98513_mmc_clock *c, unsigned r, unsigned bits)
+{
+ int error = mmc_begin(c, false);
+ if (error) return error;
+ return mmc_end(c, mmc_update(c, r, bits));
+}
+static int mmc_rate_value(unsigned requested, unsigned *encoded, unsigned *actual)
+{
+ unsigned divisor;
+ if (requested < 400000 || requested > 12000000 || !actual) return -EINVAL;
+ divisor = (192000000U + requested - 1) / requested;
+ *encoded = divisor - 1;
+ *actual = (192000000U + divisor - 1) / divisor;
+ return 0;
+}
+static void mmc_managed_release(void *p)
+{
+ /* No blind gating/reset. An unsafe initialized claim remains unavailable. */
+ nt98513_mmc_clock_release(p);
+}
+struct nt98513_mmc_clock *devm_nt98513_mmc_clock_get(struct device *dev,
+                                                 unsigned int index)
+{
+ struct nt98513_clock_owner *o;
+ struct nt98513_mmc_clock *c;
+ int error;
+ if (index > 1) return ERR_PTR(-EINVAL);
+ o = devm_nt98513_clock_owner_get(dev);
+ if (IS_ERR(o)) return ERR_PTR(PTR_ERR(o));
+ if (!o->mmc_v3) return ERR_PTR(-EINVAL);
+ c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+ if (!c) return ERR_PTR(-ENOMEM);
+ c->owner = o;
+ c->index = index;
+ error = devm_add_action_or_reset(dev, mmc_managed_release, c);
+ return error ? ERR_PTR(error) : c;
+}
+int nt98513_mmc_clock_admit(struct nt98513_mmc_clock *c)
+{
+ struct nt_mmc_state *s;
+ int error;
+ if (!c) return -EINVAL;
+ might_sleep();
+ mutex_lock(&c->owner->lock);
+ s = mmc_state(c);
+ if (s->claim || s->retired) { error = -EBUSY; goto out; }
+ error = mmc_health(c);
+ if (error) goto out;
+ s->claim = c;
+ error = mmc_begin(c, true);
+ if (!error) error = mmc_end(c, 0);
+ if (!error) s->admitted = true;
+out:
+ mutex_unlock(&c->owner->lock);
+ return error;
+}
+static int mmc_change_rate(struct nt98513_mmc_clock *c, unsigned requested,
+                           unsigned *actual_hz, bool first)
+{
+ struct nt_mmc_state *s;
+ unsigned encoded, actual;
+ int error;
+ if (!c || !actual_hz) return -EINVAL;
+ error = mmc_rate_value(requested, &encoded, &actual);
+ if (error) return error;
+ might_sleep();
+ mutex_lock(&c->owner->lock);
+ s = mmc_state(c);
+ if (s->claim != c || !s->admitted || s->retired ||
+     (first ? s->initialized : !s->initialized)) { error = -EINVAL; goto out; }
+ error = mmc_health(c);
+ if (error) goto out;
+ if (!first && s->on && s->rate == actual) {
+  error = mmc_begin(c, false);
+  if (!error) error = mmc_end(c, 0);
+  goto done;
+ }
+ /* Mark initialized before the first possible mutation, even if it fails. */
+ s->initialized = true;
+ if (first || s->on) {
+  error = mmc_set(c, MMC_GATE, 0);
+  if (error) goto out;
+  s->on = false;
+ }
+ error = mmc_set(c, MMC_DIVIDER, encoded << (c->index ? 16 : 0));
+ if (error) goto out;
+ if (first) {
+  if (!c->index) {
+   error = mmc_set(c, MMC_PHASE, 1U << 20);
+   if (error) goto out;
+  }
+  /* Stock's two pulse delays have different arbitration scope. The owner
+   * mutex spans both; WDT/Ethernet cannot interleave the prepare lifetime.
+   */
+  error = mmc_set(c, MMC_PREPARE, 0);
+  if (error) goto out;
+  udelay(10); /* outside bank */
+  error = mmc_begin(c, false);
+  if (error) goto out;
+  error = mmc_update(c, MMC_PREPARE, mmc_mask(c, MMC_PREPARE));
+  if (!error) udelay(10); /* still granted */
+  error = mmc_end(c, error);
+  if (error) goto out;
+ }
+ error = mmc_set(c, MMC_GATE, mmc_mask(c, MMC_GATE));
+ if (error) goto out;
+ s->on = true;
+ s->rate = actual;
+done:
+ if (!error) *actual_hz = actual;
+out:
+ mutex_unlock(&c->owner->lock);
+ return error;
+}
+int nt98513_mmc_clock_start(struct nt98513_mmc_clock *c, unsigned requested,
+                          unsigned *actual)
+{
+ return mmc_change_rate(c, requested, actual, true);
+}
+int nt98513_mmc_clock_rate(struct nt98513_mmc_clock *c, unsigned requested,
+                         unsigned *actual)
+{
+ return mmc_change_rate(c, requested, actual, false);
+}
+int nt98513_mmc_clock_stop(struct nt98513_mmc_clock *c)
+{
+ struct nt_mmc_state *s;
+ int error;
+ if (!c) return -EINVAL;
+ might_sleep();
+ mutex_lock(&c->owner->lock);
+ s = mmc_state(c);
+ if (s->claim != c || !s->initialized || s->retired) error = -EINVAL;
+ else {
+  error = mmc_set(c, MMC_GATE, 0);
+  if (!error) s->on = false;
+ }
+ mutex_unlock(&c->owner->lock);
+ return error;
+}
+int nt98513_mmc_clock_fault(struct nt98513_mmc_clock *c)
+{
+ int error;
+ if (!c) return -EINVAL;
+ might_sleep();
+ mutex_lock(&c->owner->lock);
+ error = mmc_health(c);
+ mutex_unlock(&c->owner->lock);
+ return error;
+}
+int nt98513_mmc_clock_release(struct nt98513_mmc_clock *c)
+{
+ struct nt_mmc_state *s;
+ int error = 0;
+ if (!c) return -EINVAL;
+ might_sleep();
+ mutex_lock(&c->owner->lock);
+ s = mmc_state(c);
+ if (s->claim != c) goto out;
+ if (!s->initialized) {
+  /* No CG write has occurred; any admission fault remains sticky in s. */
+  s->claim = NULL;
+  s->admitted = false;
+  goto out;
+ }
+ error = mmc_health(c);
+ if (error) goto out;
+ if (s->on) { error = -EBUSY; goto out; }
+ error = mmc_begin(c, false);
+ if (!error) error = mmc_end(c, 0);
+ if (!error) {
+  s->retired = true;
+  s->claim = NULL;
+  s->admitted = false;
+ }
+out:
+ mutex_unlock(&c->owner->lock);
+ return error;
+}
