+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/openipc,nt98513-shared-clock-v3.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: NT98513 shared clock owner with qualified MMC lifetimes
+maintainers:
+  - Daniel Piers <dpiers@users.noreply.github.com>
+description: |
+  The permanent CC-bank supplier owns arbitration. This node extends the v2
+  owner to exactly five sparse CG words without a second map or CC owner.
+  CCF client1 remains the Ethernet activation clock with unknown rate. MMC0/1
+  are explicit sleepable clients with independent admission and sticky faults;
+  they are not additional mutable CCF clocks. Admission requires inherited
+  parent0, gate and prepare, plus board-qualified physical ownership and stable
+  nominal 192 MHz source. The driver never reparents or initializes power/pads.
+  Controller-idle qualification is the MMC host's obligation before mutation.
+properties:
+  compatible:
+    const: openipc,nt98513-shared-clock-v3
+  reg:
+    items:
+      - description: Gate C0020074, four bytes
+      - description: Preparation C0020084, four bytes
+      - description: Parent mux C0020020, four bytes
+      - description: Divider C002003C, four bytes
+      - description: Phase C00200B0, four bytes
+  reg-names:
+    items:
+      - const: gate
+      - const: prepare
+      - const: mux
+      - const: divider
+      - const: phase
+  openipc,cc-bank:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The same permanent core1 CC-bank supplier used by v2 and GPIO
+  '#clock-cells':
+    const: 1
+required: [compatible, reg, reg-names, 'openipc,cc-bank', '#clock-cells']
+additionalProperties: false
