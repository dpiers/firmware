  struct nt_cg_state state;
--- /dev/null
+++ b/include/linux/soc/nt98513_mmc_clock.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef NT98513_MMC_CLOCK_H
+#define NT98513_MMC_CLOCK_H
+struct device;
+struct nt98513_mmc_clock;
+/* All operations sleep. No controller access is permitted before admit succeeds.
+ * The caller proves exclusive physical ownership, a stable nominal 192 MHz
+ * source, and controller/DMA idle before start/rate/stop. No operation reparents.
+ * Rates are nominal software values, not physical frequency measurements.
+ */
+struct nt98513_mmc_clock *devm_nt98513_mmc_clock_get(struct device *dev,
+                                                 unsigned int index);
+int nt98513_mmc_clock_admit(struct nt98513_mmc_clock *clock);
+int nt98513_mmc_clock_start(struct nt98513_mmc_clock *clock,
+                          unsigned int requested_hz, unsigned int *actual_hz);
+int nt98513_mmc_clock_rate(struct nt98513_mmc_clock *clock,
+                         unsigned int requested_hz, unsigned int *actual_hz);
+int nt98513_mmc_clock_stop(struct nt98513_mmc_clock *clock);
+int nt98513_mmc_clock_fault(struct nt98513_mmc_clock *clock);
+/* Untouched admission may be dropped; initialized claims retire only verified
+ * OFF. Failure/uncertainty leaves the instance unavailable for this boot.
+ */
+int nt98513_mmc_clock_release(struct nt98513_mmc_clock *clock);
+#endif
