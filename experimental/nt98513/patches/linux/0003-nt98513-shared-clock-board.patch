+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef NT98513_CLOCK_TXN_H
+#define NT98513_CLOCK_TXN_H
+enum nt_cg_reg { NT_CG_GATE, NT_CG_PREPARE, NT_CG_REQUEST, NT_CG_GRANT, NT_CG_RELEASE };
+struct nt_cg_io {
+ void *context;
+ unsigned (*read)(void *, enum nt_cg_reg);
+ void (*write)(void *, enum nt_cg_reg, unsigned);
+ int (*wait_grant)(void *, int want_set);
+};
+/* Caller exclusively serializes state and the entire transaction. */
+struct nt_cg_state { int fault; unsigned successful_clients; };
+int nt_cg_activate(struct nt_cg_state *, const struct nt_cg_io *, unsigned client);
