+// SPDX-License-Identifier: GPL-2.0-only
+/* Unbooted experimental variant: enabled nodes perform MMIO on probe. */
+#include "nt98513.dts"
+
+/ {
+ clock_owner: clock-controller@c0020074 {
+  compatible = "openipc,nt98513-shared-clock-v1";
+  reg = <0xc0020074 4>, <0xc0020084 4>, <0xc0090050 12>;
+  reg-names = "gate", "prepare", "resource2";
+  #clock-cells = <1>;
+ };
+};
+
+&{/watchdog@c0050000} {
+ compatible = "openipc,nt98513-watchdog-shared-v1";
+ reg = <0xc0050000 16>;
+ /delete-property/ reg-names;
+ openipc,clock-owner = <&clock_owner>;
+};
