+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0-only
+# Check requested values before Kconfig can discard an incompatible board.
+set -eu
+[ "$#" -eq 1 ] || { echo "NT98513: expected configuration path" >&2; exit 1; }
+[ -e "$1" ] || exit 0
+[ -r "$1" ] || { echo "NT98513: unreadable configuration: $1" >&2; exit 1; }
+awk '
+function reject(s) { print "NT98513 shared-clock configuration: " s > "/dev/stderr"; bad=1 }
+BEGIN {
+ split("MACH_NT98513 OF COMMON_CLK WATCHDOG WATCHDOG_HANDLE_BOOT_ENABLED WATCHDOG_NOWAYOUT NT98513_SHARED_CLOCK_BOARD NT98513_SHARED_CLOCK NT98513_WATCHDOG_SHARED", yes, " ")
+ split("NT98513_WATCHDOG SMP SUSPEND HIBERNATION OF_DYNAMIC", no, " ")
+ for (i in yes) relevant[yes[i]]=1
+ for (i in no) relevant[no[i]]=1
+ relevant["WATCHDOG_OPEN_TIMEOUT"]=1
+}
+/^CONFIG_[A-Z0-9_]+=/ {
+ key=$0; sub(/^CONFIG_/, "", key); sub(/=.*/, "", key)
+ val=$0; sub(/^[^=]*=/, "", val)
+ if (key in relevant) { count[key]++; value[key]=val }
+ if (key ~ /^NT98513_(SHARED_CLOCK_BOARD|SHARED_CLOCK|WATCHDOG_SHARED)$/ && val != "n") active=1
+}
+/^# CONFIG_[A-Z0-9_]+ is not set$/ {
+ key=$0; sub(/^# CONFIG_/, "", key); sub(/ is not set$/, "", key)
+ if (key in relevant) { count[key]++; value[key]="n" }
+}
+END {
+ split("NT98513_SHARED_CLOCK_BOARD NT98513_SHARED_CLOCK NT98513_WATCHDOG_SHARED", trio, " ")
+ for (i in trio) if (value[trio[i]] != "" && value[trio[i]] != "n") active=1
+ if (!active) exit 0
+ for (key in count) if (count[key] != 1) reject("duplicate " key)
+ for (i in yes) if (value[yes[i]] != "y") reject(yes[i] " must be y")
+ for (i in no) if (value[no[i]] != "" && value[no[i]] != "n") reject(no[i] " must be n")
+ if (value["WATCHDOG_OPEN_TIMEOUT"] != "0") reject("WATCHDOG_OPEN_TIMEOUT must be 0")
+ exit bad
+}' "$1"
