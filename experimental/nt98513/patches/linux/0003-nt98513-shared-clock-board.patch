+title: NT98513 permanent shared clock and resource2 owner
+maintainers:
+  - Daniel Piers <danielpiers@gmail.com>
+description: |
+  Static built-in candidate. Exactly C0020074/4, C0020084/4 and C0090050/12
+  are admitted by the driver. ID 1 exposes sticky Ethernet activation with
+  unknown rate; ID 0 is reserved. No reset pulse or clock disable is defined.
+properties:
+  compatible:
+    const: openipc,nt98513-shared-clock-v1
+  reg:
+    minItems: 3
+    maxItems: 3
+  reg-names:
+    items:
+      - const: gate
+      - const: prepare
+      - const: resource2
+  '#clock-cells':
+    const: 1
+required: [compatible, reg, reg-names, '#clock-cells']
+additionalProperties: false
