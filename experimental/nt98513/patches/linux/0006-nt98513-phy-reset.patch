@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef DWMAC_NT98513_PHY_H
+#define DWMAC_NT98513_PHY_H
+/* Included after PHYLIB and delay definitions. This is the production policy,
+ * also exercised with host MDIO/time/locking fixtures in the offline tests.
+ */
+static inline int nt98513_phy_reset(struct phy_device *phy)
+{
+	int ret, val;
+
+	device_lock(&phy->mdio.dev);
+	/* A specific PHY driver's probe may already have programmed registers.
+	 * Its own attach/reset/configuration path must retain control.
+	 */
+	if (phy->mdio.dev.driver || phy->drv) {
+		ret = 0;
+		goto out;
+	}
+	/* A reset may erase early fixups needed by generic get_features before
+	 * phy_init_hw reapplies them. Do not guess how to replay such setup.
+	 */
+	if (phy->is_c45 || phy->has_fixups) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	if (phy->attached_dev) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* Stock resets only its discovered PHY via BMCR bit15. This is not
+	 * evidence for any GPIO, power/reset wiring or vendor PHY register.
+	 */
+	val = phy_read(phy, MII_BMCR);
+	if (val < 0) {
+		ret = val;
+		goto out;
+	}
+	ret = phy_write(phy, MII_BMCR, val | BMCR_RESET);
+	if (ret)
+		goto out;
+	/* Use PHYLIB's standard 600ms reset poll and 1ms success settlement;
+	 * each underlying stmmac C22 transaction is itself bounded.
+	 */
+	ret = phy_read_poll_timeout(phy, MII_BMCR, val, !(val & BMCR_RESET),
+				    50000, 600000, true);
+	if (!ret)
+		msleep(1);
+out:
+	device_unlock(&phy->mdio.dev);
+	return ret;
+}
+#endif
