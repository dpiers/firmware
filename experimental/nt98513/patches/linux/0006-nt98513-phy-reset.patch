@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef STMMAC_MDIO_SETUP_H
+#define STMMAC_MDIO_SETUP_H
+/* The bus is registered, but not yet published in priv->mii. Callback failure
+ * must unwind it exactly once, just like stmmac's no-PHY path.
+ */
+static inline int stmmac_mdio_finish_registration(struct stmmac_priv *priv,
+						struct mii_bus *bus)
+{
+	struct phy_device *phy;
+	int ret = 0;
+
+	if (priv->plat->mdio_phy_setup) {
+		phy = priv->plat->phy_addr >= 0 &&
+		      priv->plat->phy_addr < PHY_MAX_ADDR ?
+			mdiobus_get_phy(bus, priv->plat->phy_addr) : NULL;
+		ret = phy ? priv->plat->mdio_phy_setup(phy) : -ENODEV;
+	}
+	if (ret) {
+		mdiobus_unregister(bus);
+		mdiobus_free(bus);
+		return ret;
+	}
+	priv->mii = bus;
+	return 0;
+}
+#endif
