+// SPDX-License-Identifier: GPL-2.0-only
+/dts-v1/;
+/ {
+ compatible = "openipc,nt98513-ram-only";
+ model = "Independent NT98513 RAM-only build milestone";
+ #address-cells = <1>;
+ #size-cells = <1>;
+ chosen { stdout-path = "serial0:115200n8"; };
+ aliases { serial0 = &uart0; };
+ /* Deliberately exclude [0,0x101000), U-Boot reuse [0x3400000,0x3b00000)
+  * and everything at/above RTOS base. No inferred allmem=128M admission. */
+ memory@101000 { device_type = "memory"; reg = <0x00101000 0x032ff000>; };
+ intc: interrupt-controller@c0080000 {
+  compatible = "openipc,nt98513-intc";
+  reg = <0xc0080000 0x1000>;
+  interrupt-controller;
+  #interrupt-cells = <1>;
+  #address-cells = <0>;
+ };
+ uart0: serial@c0300000 {
+  compatible = "ns16550a";
+  reg = <0xc0300000 0x1000>;
+  interrupt-parent = <&intc>;
+  interrupts = <44>;
+  clock-frequency = <48000000>;
+  reg-shift = <2>;
+  reg-io-width = <4>;
+  no-loopback-test;
+ };
+};
