+int fotg210_nt98513_probe(struct platform_device *pdev, struct fotg210 *fotg)
+{
+	struct usb_hcd *hcd;
+	struct fotg210_hcd *fotg210;
+	int irq, ret;
+
+	/* Raw hardware IRQ27 was checked in DT; this is its Linux domain mapping. */
+	irq = platform_get_irq(pdev, 0);
+	if (irq <= 0)
+		return irq ? irq : -EINVAL;
+	hcd = usb_create_hcd(&nt98513_hc_driver, &pdev->dev, dev_name(&pdev->dev));
+	if (!hcd)
+		return -ENOMEM;
+	hcd->has_tt = 1;
+	hcd->regs = fotg->base;
+	hcd->rsrc_start = fotg->res->start;
+	hcd->rsrc_len = resource_size(fotg->res);
+	fotg210 = hcd_to_fotg210(hcd);
+	fotg210->fotg = fotg;
+	fotg210->caps = hcd->regs;
+	ret = usb_add_hcd(hcd, irq, 0);
+	if (ret) {
+		/*
+		 * reset/IRQ/start failures may skip .stop; registration failure calls it. The
+		 * allocation claim makes this common unwind exactly-once.
+		 */
+		if (fotg->nt->state.allocated)
+			fotg210_stop(hcd);
+		platform_set_drvdata(pdev, NULL);
+		usb_put_hcd(hcd);
+		return ret;
+	}
+	/*
+	 * All core failure paths have finished. A fault during registration is
+	 * reported on this successfully registered, permanently bound HCD; it
+	 * must not become a probe error which frees a still-registered root hub.
+	 */
+	spin_lock_irq(&fotg210->lock);
+	fotg->nt->core_ready = true;
+	if (fotg210->shutdown)
+		nt98513_notify_death(fotg210);
+	spin_unlock_irq(&fotg210->lock);
+	device_wakeup_disable(&pdev->dev);
+	platform_set_drvdata(pdev, hcd);
+	return 0;
+}
