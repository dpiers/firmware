@@ -0,0 +1,210 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Production NT98513 policy. Callback MMIO permits inert host verification. */
+#ifndef NT98513_USB_POLICY_H
+#define NT98513_USB_POLICY_H
+struct nt_usb_io {
+	void *context;
+	unsigned int (*read)(void *context, unsigned int bank, unsigned int offset);
+	void (*write)(void *context, unsigned int bank, unsigned int offset, unsigned int value);
+	void (*delay)(void *context, unsigned int us);
+};
+
+struct nt_usb_state {
+	unsigned int mux, trim14, trim18, hcs;
+	unsigned int allocated, published;
+};
+
+enum nt_usb_result {
+	NT_USB_OK, NT_USB_INVALID, NT_USB_TIMEOUT, NT_USB_REMOVED
+};
+
+static inline int nt_usb_admit(unsigned int exclusive, unsigned int inherited,
+			       unsigned int stable_clock, unsigned int host,
+			       unsigned long long base, unsigned long long size,
+			       unsigned long long phy, unsigned long long phy_size,
+			       unsigned int hwirq)
+{
+	return exclusive && inherited && stable_clock && host && base == 0xc0600000 &&
+		size == 0x400 && phy == 0xc0601000 && phy_size == 0x200 && hwirq == 27;
+}
+
+static inline int nt_usb_caps(unsigned int cap, unsigned int hcs, unsigned int hcc)
+{
+	/* Conservative software whitelist, not a measured live capability value. */
+	return cap == 0x01000010 && (hcs & 15) == 1 && !(hcs & 0xff00) && !(hcc & 1) &&
+		hcs != ~0u && hcc != ~0u;
+}
+
+static inline unsigned int nt_usb_selector(unsigned int mux)
+{
+	switch (mux & 0x300) {
+	case 0x100:
+		return 3;
+	case 0x300:
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static inline unsigned int nt_usb_port_value(unsigned int old,
+					      unsigned int set, unsigned int clear)
+{
+	return ((old & ~clear) | set) & ~0x2au;
+}
+
+static inline int nt_usb_transfer_supported(unsigned int type)
+{
+	return type == 2 || type == 3;	/* Linux PIPE_CONTROL / PIPE_BULK */
+}
+
+static inline int nt_usb_allocate_once(struct nt_usb_state *s)
+{
+	if (s->allocated)
+		return 0;
+	s->allocated = 1;
+	return 1;
+}
+
+static inline int nt_usb_release(struct nt_usb_state *s, int halted)
+{
+	if (!s->allocated || (s->published && !halted))
+		return 0;
+	s->allocated = 0;
+	return 1;
+}
+
+static inline unsigned int nt_usb_read(const struct nt_usb_io *io,
+				       unsigned int bank, unsigned int offset)
+{
+	return io->read(io->context, bank, offset);
+}
+
+static inline void nt_usb_write(const struct nt_usb_io *io,
+				unsigned int bank, unsigned int offset, unsigned int value)
+{
+	io->write(io->context, bank, offset, value);
+}
+
+static inline enum nt_usb_result nt_usb_wait(const struct nt_usb_io *io,
+					    unsigned int offset, unsigned int mask,
+					    unsigned int want, unsigned int limit)
+{
+	unsigned int i, value;
+
+	for (i = 0; i < limit; i++) {
+		value = nt_usb_read(io, 0, offset);
+		if (value == ~0u)
+			return NT_USB_REMOVED;
+		if ((value & mask) == want)
+			return NT_USB_OK;
+		io->delay(io->context, 1);
+	}
+	return NT_USB_TIMEOUT;
+}
+
+static inline enum nt_usb_result nt_usb_halt(const struct nt_usb_io *io)
+{
+	unsigned int value = nt_usb_read(io, 0, 0x10);
+
+	if (value == ~0u)
+		return NT_USB_REMOVED;
+	nt_usb_write(io, 0, 0x18, 0);
+	/* RUN, async/periodic enables and async-advance request. */
+	nt_usb_write(io, 0, 0x10, value & ~0x71u);
+	return nt_usb_wait(io, 0x14, 0x1000, 0x1000, 2000);
+}
+
+static inline int nt_usb_update(const struct nt_usb_io *io, unsigned int bank,
+				unsigned int offset, unsigned int mask, unsigned int value)
+{
+	unsigned int old = nt_usb_read(io, bank, offset);
+
+	if (old == ~0u)
+		return 0;
+	nt_usb_write(io, bank, offset, (old & ~mask) | (value & mask));
+	old = nt_usb_read(io, bank, offset);
+	return old != ~0u && (old & mask) == (value & mask);
+}
+
+static inline int nt_usb_literal(const struct nt_usb_io *io, unsigned int bank,
+				 unsigned int offset, unsigned int value)
+{
+	nt_usb_write(io, bank, offset, value);
+	return nt_usb_read(io, bank, offset) == value;
+}
+
+static inline int nt_usb_live(const struct nt_usb_io *io, const struct nt_usb_state *s)
+{
+	unsigned int mux = nt_usb_read(io, 2, 0), role = nt_usb_read(io, 0, 0x80);
+	unsigned int selector = nt_usb_read(io, 0, 0x304), trim14 = nt_usb_read(io, 1, 0x14);
+	unsigned int trim18 = nt_usb_read(io, 1, 0x18), wrapper = nt_usb_read(io, 0, 0x108);
+
+	return mux != ~0u && role != ~0u && selector != ~0u && trim14 != ~0u &&
+		trim18 != ~0u && wrapper != ~0u && (mux & 0x300) == s->mux &&
+		!(role & (1u << 20)) &&
+		(selector & 3) == nt_usb_selector(s->mux) && (trim14 & 0x1c) == s->trim14 &&
+		(trim18 & 0x0e) == s->trim18 && (wrapper & 1);
+}
+
+static inline enum nt_usb_result nt_usb_initialize(const struct nt_usb_io *io,
+						   struct nt_usb_state *s)
+{
+	unsigned int cap, hcc, role, inherited, mux, command;
+	enum nt_usb_result result;
+
+	cap = nt_usb_read(io, 0, 0);
+	s->hcs = nt_usb_read(io, 0, 4);
+	hcc = nt_usb_read(io, 0, 8);
+	if (!nt_usb_caps(cap, s->hcs, hcc))
+		return NT_USB_INVALID;
+	role = nt_usb_read(io, 0, 0x80);
+	inherited = nt_usb_read(io, 0, 0x108);
+	s->trim14 = nt_usb_read(io, 1, 0x14);
+	s->trim18 = nt_usb_read(io, 1, 0x18);
+	if (role == ~0u || (role & (1u << 20)) || inherited == ~0u || !(inherited & 1) ||
+	    s->trim14 == ~0u || s->trim18 == ~0u)
+		return NT_USB_INVALID;
+	s->trim14 &= 0x1c;
+	s->trim18 &= 0x0e;
+	result = nt_usb_halt(io);
+	if (result)
+		return result;
+	command = nt_usb_read(io, 0, 0x10);
+
+	if (command == ~0u)
+		return NT_USB_REMOVED;
+	nt_usb_write(io, 0, 0x10, command | 2);
+	result = nt_usb_wait(io, 0x10, 2, 0, 250000);
+	if (result)
+		return result;
+	/*
+	 * Reestablish the selected original Linux sequence after reset. No generic Faraday GMIR,
+	 * OTGISR, eFuse reader, or shared clock writes are used.
+	 */
+	if (!nt_usb_update(io, 1, 0x14, 0x1c, s->trim14) ||
+	    !nt_usb_update(io, 1, 0x18, 0x0e, s->trim18) ||
+	    !nt_usb_update(io, 0, 0x108, 1, 1) ||
+	    !nt_usb_literal(io, 0, 0x310, 1) ||
+	    !nt_usb_update(io, 0, 0x100, 1u << 9, 0) ||
+	    !nt_usb_update(io, 0, 0x1c8, 1u << 5, 0) ||
+	    !nt_usb_update(io, 0, 0x40, 1u << 6, 0) ||
+	    !nt_usb_update(io, 0, 0x1c4, 1u << 2, 0) ||
+	    !nt_usb_update(io, 0, 0x80, 1u << 31, 0) ||
+	    !nt_usb_update(io, 0, 0x40, 0x3f3c, 0x220c) ||
+	    !nt_usb_update(io, 0, 0x80, 1u << 5, 0))
+		return NT_USB_INVALID;
+	io->delay(io->context, 2);
+	if (!nt_usb_update(io, 0, 0x80, 1u << 4, 1u << 4) ||
+	    !nt_usb_literal(io, 1, 0x144, 0x20) || !nt_usb_literal(io, 1, 0x140, 0x30) ||
+	    !nt_usb_literal(io, 1, 0x148, 0x6d) || !nt_usb_literal(io, 1, 0x144, 0))
+		return NT_USB_INVALID;
+	mux = nt_usb_read(io, 2, 0);
+	if (mux == ~0u)
+		return NT_USB_REMOVED;
+	s->mux = mux & 0x300;
+	if (!nt_usb_update(io, 0, 0x304, 3, nt_usb_selector(s->mux)) || !nt_usb_live(io, s))
+		return NT_USB_INVALID;
+	return NT_USB_OK;
+}
+#endif
