 include $(srctree)/arch/mips/nt98513/clock-config-guard.mk
-ifeq ($(CONFIG_NT98513_ETHERNET_BOARD),y)
+ifeq ($(CONFIG_NT98513_USB_HOST_BOARD),y)
+dtb-$(CONFIG_MACH_NT98513) += nt98513-usb-host.dtb
+else ifeq ($(CONFIG_NT98513_ETHERNET_BOARD),y)
 dtb-$(CONFIG_MACH_NT98513) += nt98513-ethernet.dtb
 else ifeq ($(CONFIG_NT98513_SHARED_CLOCK_BOARD),y)
 dtb-$(CONFIG_MACH_NT98513) += nt98513-shared-clock.dtb
