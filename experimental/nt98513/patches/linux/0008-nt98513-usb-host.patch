+// SPDX-License-Identifier: GPL-2.0-only
+#include "nt98513-ethernet.dts"
+
+/ {
+	usb_host: usb@c0600000 {
+		compatible = "openipc,nt98513-usb-host-v1";
+		reg = <0xc0600000 0x400>, <0xc0601000 0x200>;
+		reg-names = "host", "phy";
+		interrupt-parent = <&intc>;
+		interrupts = <27>;
+		interrupt-names = "host";
+		dr_mode = "host";
+		/* No inherited-state, stable-clock or ownership assertions are supplied. */
+		status = "disabled";
+	};
+};
