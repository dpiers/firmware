+/* NT setup is called only by usb_add_hcd, before IRQ/RUN publication. */
+static int nt98513_hcd_setup(struct usb_hcd *hcd)
+{
+	struct fotg210_hcd *fotg210 = hcd_to_fotg210(hcd);
+	struct nt98513_usb *nt = fotg210->fotg->nt;
+	int ret;
+
+	if (nt->state.allocated || nt->state.published)
+		return -EBUSY;
+	spin_lock_init(&fotg210->lock);
+	ret = nt_usb_initialize(&nt->io, &nt->state);
+	if (ret)
+		return ret == NT_USB_TIMEOUT ? -ETIMEDOUT : -ENODEV;
+	fotg210->regs = (void __iomem *)fotg210->caps + 0x10;
+	fotg210->hcs_params = nt->state.hcs;
+	fotg210->sbrn = HCD_USB2;
+	if (!nt_usb_allocate_once(&nt->state))
+		return -EBUSY;
+	ret = hcd_fotg210_init(hcd);
+	if (ret)
+		nt_usb_release(&nt->state, 1);	/* allocator already unwound */
+	return ret;
+}
+
+static int nt98513_hcd_run(struct usb_hcd *hcd)
+{
+	int ret;
+
+	/*
+	 * IRQ is already requested by usb_add_hcd, but no root hub or URBs are published yet.
+	 * Serialize initial RUN against fatal IRQ handling.
+	 */
+	disable_irq(hcd->irq);
+	ret = fotg210_run(hcd);
+	enable_irq(hcd->irq);
+	return ret;
+}
