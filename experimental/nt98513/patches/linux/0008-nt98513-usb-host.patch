+// SPDX-License-Identifier: GPL-2.0-only
+/* Disabled-by-default, inherited-state host candidate. No cold initialization. */
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/usb.h>
+#include <linux/usb/hcd.h>
+#include "fotg210.h"
+
+static u32 nt_read(void *context, unsigned int bank, unsigned int offset)
+{
+	struct nt98513_usb *nt = context;
+
+	return readl((bank == 0 ? nt->base : bank == 1 ? nt->phy : nt->mux) + offset);
+}
+
+static void nt_write(void *context, unsigned int bank, unsigned int offset, u32 value)
+{
+	struct nt98513_usb *nt = context;
+
+	writel(value, (bank == 0 ? nt->base : nt->phy) + offset);
+}
+
+static void nt_delay(void *context, unsigned int us)
+{
+	(void)context;
+	udelay(us);
+}
+
+static int nt_admit(struct platform_device *pdev)
+{
+	static const char *const allowed[] = {
+		"compatible", "reg", "reg-names", "interrupt-parent", "interrupts",
+		"interrupt-names", "status", "dr_mode",
+		"openipc,linux-exclusive-ownership",
+		"openipc,stock-initialized-host-handoff",
+		"openipc,stable-usb-clock", "phandle", "linux,phandle", "name",
+	};
+	struct device_node *np = pdev->dev.of_node;
+	struct resource *base, *phy;
+	struct of_phandle_args irq;
+	struct property *prop;
+	const char *mode;
+	unsigned int i, hwirq = ~0u;
+	int ret;
+
+	if (!np || of_get_child_count(np) || of_property_count_strings(np, "compatible") != 1 ||
+	    of_irq_count(np) != 1 || of_property_count_strings(np, "reg-names") != 2 ||
+	    of_property_match_string(np, "reg-names", "host") != 0 ||
+	    of_property_match_string(np, "reg-names", "phy") != 1 ||
+	    of_property_count_strings(np, "interrupt-names") != 1 ||
+	    of_property_match_string(np, "interrupt-names", "host") != 0)
+		return -EINVAL;
+	for_each_property_of_node(np, prop) {
+		for (i = 0; i < ARRAY_SIZE(allowed); i++)
+			if (!strcmp(prop->name, allowed[i]))
+				break;
+		if (i == ARRAY_SIZE(allowed))
+			return -EINVAL;
+	}
+	base = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	phy = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!base || !phy || platform_get_resource(pdev, IORESOURCE_MEM, 2))
+		return -EINVAL;
+	ret = of_irq_parse_one(np, 0, &irq);
+	if (ret)
+		return ret;
+	if (irq.args_count == 1 && of_device_is_compatible(irq.np, "openipc,nt98513-intc"))
+		hwirq = irq.args[0];
+	of_node_put(irq.np);
+	ret = of_property_read_string(np, "dr_mode", &mode);
+	if (!nt_usb_admit(of_property_read_bool(np, "openipc,linux-exclusive-ownership"),
+			  of_property_read_bool(np, "openipc,stock-initialized-host-handoff"),
+			  of_property_read_bool(np, "openipc,stable-usb-clock"),
+			  !ret && !strcmp(mode, "host"),
+			  base->start, resource_size(base), phy->start, resource_size(phy), hwirq))
+		return -EINVAL;
+	return 0;
+}
+
+static int nt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct nt98513_usb *nt;
+	struct fotg210 *fotg;
+	int ret = nt_admit(pdev);
+
+	/* No MMIO or USB-core PHY helper before explicit deployment admission. */
+	if (ret)
+		return dev_err_probe(dev, ret, "USB handoff contract rejected\n");
+	if (usb_disabled())
+		return -ENODEV;
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	fotg = devm_kzalloc(dev, sizeof(*fotg), GFP_KERNEL);
+	nt = devm_kzalloc(dev, sizeof(*nt), GFP_KERNEL);
+	if (!fotg || !nt)
+		return -ENOMEM;
+	nt->base = devm_platform_get_and_ioremap_resource(pdev, 0, &fotg->res);
+	if (IS_ERR(nt->base))
+		return PTR_ERR(nt->base);
+	nt->phy = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(nt->phy))
+		return PTR_ERR(nt->phy);
+	/*
+	 * Intentional four-byte, read-only shared view. No CG reservation/write: the external
+	 * handoff must keep this mux and USB clocks stable for life.
+	 */
+	nt->mux = devm_ioremap(dev, 0xc0020010, 4);
+	if (!nt->mux)
+		return -ENOMEM;
+	nt->io = (struct nt_usb_io) {
+		.context = nt,
+		.read = nt_read,
+		.write = nt_write,
+		.delay = nt_delay,
+	};
+	fotg->dev = dev;
+	fotg->base = nt->base;
+	fotg->nt = nt;
+	return fotg210_nt98513_probe(pdev, fotg);
+}
+
+static void nt_shutdown(struct platform_device *pdev)
+{
+	struct usb_hcd *hcd = platform_get_drvdata(pdev);
+
+	if (hcd)
+		hcd->driver->shutdown(hcd);
+}
+
+static const struct of_device_id nt_match[] = {
+	{ .compatible = "openipc,nt98513-usb-host-v1" },
+	{ }
+};
+static struct platform_driver nt_driver = {
+	.probe = nt_probe,
+	.shutdown = nt_shutdown,
+	.driver = {
+		.name = "nt98513-usb-host",
+		.of_match_table = nt_match,
+		.suppress_bind_attrs = true,
+	},
+};
+/* Builtin and permanent: no unbind, module unload, PM or dynamic OF support. */
+builtin_platform_driver(nt_driver);
+MODULE_DESCRIPTION("Experimental NT98513 inherited USB host");
+MODULE_LICENSE("GPL");
