 	dev_warn(fotg210_to_hcd(fotg210)->self.controller, fmt, ## args)
 
+/*
+ * NT-only lifetime rule: proof of HALT precedes fatal notification/free.
+ * Merely retaining our pools would not retain USB-core/client URB buffers.
+ * Call with the HCD lock held once IRQs/timers can run.
+ */
+static int nt98513_require_halt(struct fotg210_hcd *fotg210)
+{
+	struct nt98513_usb *nt = fotg210->fotg->nt;
+	enum nt_usb_result result;
+
+	if (!nt)
+		return 0;
+	result = nt_usb_halt(&nt->io);
+	if (result && nt->state.published)
+		panic("NT98513 USB: DMA halt failed; refusing buffer reclamation");
+	if (result)
+		return -EIO;
+	fotg210->command &= ~(CMD_RUN | CMD_ASE | CMD_PSE | CMD_IAAD);
+	fotg210->rh_state = FOTG210_RH_HALTED;
+	return 0;
+}
+
+/*
+ * usb_hc_died queues work which dereferences root_hub even before registration.
+ * Keep that work out of usb_add_hcd's failure unwind. Called with HCD lock held.
+ */
+static void nt98513_notify_death(struct fotg210_hcd *fotg210)
+{
+	struct nt98513_usb *nt = fotg210->fotg->nt;
+
+	if (nt->core_ready && !nt->death_notified) {
+		nt->death_notified = true;
+		usb_hc_died(fotg210_to_hcd(fotg210));
+	}
+}
+
+static bool nt98513_check_live(struct fotg210_hcd *fotg210)
+{
+	struct nt98513_usb *nt = fotg210->fotg->nt;
+	u32 status;
+
+	if (!nt || !nt->state.published)
+		return true;
+	if (fotg210->shutdown)
+		return false;
+	status = nt_usb_read(&nt->io, 0, 0x14);
+	if (nt_usb_live(&nt->io, &nt->state) && status != ~0u && !(status & STS_FATAL))
+		return true;
+	nt98513_require_halt(fotg210);
+	fotg210->shutdown = true;
+	fotg210->enabled_hrtimer_events = 0;
+	nt98513_notify_death(fotg210);
+	return false;
+}
+
+static u32 fotg210_port_rwc(struct fotg210_hcd *fotg210)
+{
+	return fotg210->fotg->nt ? 0x2a : PORT_RWC_BITS;
+}
