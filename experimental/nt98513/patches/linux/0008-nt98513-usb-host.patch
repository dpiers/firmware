--- /dev/null
+++ b/Documentation/devicetree/bindings/usb/openipc,nt98513-usb-host.yaml
@@ -0,0 +1,71 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/usb/openipc,nt98513-usb-host.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Experimental NT98513 stock-initialized USB host
+
+maintainers:
+  - OpenIPC Developers <dev@openipc.org>
+
+description: |
+  A permanent host-only experimental FOTG-derived candidate, not a cold-start
+  driver. Runtime capability checks admit a conservative single-port subset.
+  The two USB mappings are separate. C0020010 is additionally observed through
+  a minimal read-only shared mapping; the driver never writes the clock mux.
+  Deployment assertions must come from an independently established handoff.
+  They cannot prove RTOS/loader quiescence, PHY readiness, VBUS or clock state.
+  A bounded halt failure after Linux DMA publication causes a kernel panic to
+  prevent USB core or clients from reclaiming buffers still visible to DMA.
+
+properties:
+  compatible:
+    const: openipc,nt98513-usb-host-v1
+  reg:
+    items:
+      - description: Controller C0600000, 0x400 bytes
+      - description: PHY C0601000, 0x200 bytes
+  reg-names:
+    items:
+      - const: host
+      - const: phy
+  interrupts:
+    maxItems: 1
+  interrupt-names:
+    const: host
+  dr_mode:
+    const: host
+  openipc,linux-exclusive-ownership:
+    type: boolean
+    description: |
+      Loader and RTOS USB/PHY/IRQ/DMA writers and the registered RTOS callback
+      are quiesced and excluded for the complete Linux driver lifetime.
+  openipc,stock-initialized-host-handoff:
+    type: boolean
+    description: |
+      Stock initialization completed, with qualified PHY trim, role, pads,
+      VBUS/power and IRQ27 routing. The driver preserves inherited PHY14/18
+      fields across its bounded controller reset and reestablishes the selected
+      Linux wrapper sequence. This assertion does not prove physical readiness.
+  openipc,stable-usb-clock:
+    type: boolean
+    description: |
+      Clock gates, rates and APB mux are stable throughout the Linux lifetime,
+      after Linux clock setup. A fresh C0020010 field selects USB304 bits1:0.
+      Register snapshots do not synchronize or exclude a concurrent writer.
+  status: true
+
+required: [compatible, reg, reg-names, interrupts, interrupt-names, dr_mode]
+allOf:
+  - if:
+      properties:
+        status:
+          const: disabled
+      required: [status]
+    else:
+      required:
+        - openipc,linux-exclusive-ownership
+        - openipc,stock-initialized-host-handoff
+        - openipc,stable-usb-clock
+additionalProperties: false
--- a/arch/mips/boot/dts/nt98513/Makefile
