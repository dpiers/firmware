+++ b/drivers/mmc/host/nt98513/nt98513-mmc-driver.c
@@ -0,0 +1,516 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Permanent experimental native SD host; board power/pads are inherited. */
+#include <linux/atomic.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/ktime.h>
+#include <linux/mmc/host.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/soc/nt98513_mmc_clock.h>
+#include <linux/workqueue.h>
+#include "nt98513-mmc.h"
+
+struct nt_host {
+	struct mmc_host *mmc;
+	struct nt98513_mmc_clock *clock;
+	void __iomem *regs;
+	struct mutex lock;
+	spinlock_t irq_lock;
+	struct work_struct work;
+	struct nt_mmc core;
+	int irq;
+	atomic_t irq_disabled;
+	bool irq_live, registered;
+};
+
+struct nt_request {
+	struct nt_mmc_request core;
+	struct mmc_request *mrq;
+};
+
+static unsigned nt_host_read(void *context, unsigned offset)
+{
+	struct nt_host *h = context;
+	unsigned long flags;
+	unsigned value = ~0U;
+
+	/* This !SMP host can be interrupted between any two worker accesses. */
+	local_irq_save(flags);
+	if (!READ_ONCE(h->core.fault)) {
+		value = readl(h->regs + offset);
+		/* FIFO and response words have no reserved all-ones sentinel. */
+		if (value == ~0U && offset != 0x100 &&
+		    offset != 8 && offset != 12 && offset != 16 && offset != 20)
+			h->core.fault = -EIO;
+	}
+	local_irq_restore(flags);
+	return value;
+}
+
+static void nt_host_write(void *context, unsigned offset, unsigned value)
+{
+	struct nt_host *h = context;
+	unsigned long flags;
+
+	local_irq_save(flags);
+	if (!READ_ONCE(h->core.fault))
+		writel(value, h->regs + offset);
+	local_irq_restore(flags);
+}
+
+static unsigned long long nt_host_now(void *context)
+{
+	(void)context;
+	return ktime_to_us(ktime_get());
+}
+
+static void nt_host_relax(void *context)
+{
+	(void)context;
+	usleep_range(50, 100);
+}
+
+static void nt_host_lock(void *context)
+{
+	struct nt_host *h = context;
+	mutex_lock(&h->lock);
+}
+
+static void nt_host_unlock(void *context)
+{
+	struct nt_host *h = context;
+	mutex_unlock(&h->lock);
+}
+
+static unsigned long nt_host_irq_lock(void *context)
+{
+	struct nt_host *h = context;
+	unsigned long flags;
+	spin_lock_irqsave(&h->irq_lock, flags);
+	return flags;
+}
+
+static void nt_host_irq_unlock(void *context, unsigned long flags)
+{
+	struct nt_host *h = context;
+	spin_unlock_irqrestore(&h->irq_lock, flags);
+}
+
+/* Terminal faults never re-enable this dedicated IRQ. The latch prevents
+ * process/IRQ races and repeated cleanup from increasing its disable depth.
+ */
+static void nt_disable_irq(struct nt_host *h)
+{
+	unsigned long flags;
+
+	/* Do not expose a set latch before the Linux level IRQ is disabled. */
+	local_irq_save(flags);
+	if (READ_ONCE(h->irq_live) && !atomic_cmpxchg(&h->irq_disabled, 0, 1))
+		disable_irq_nosync(h->irq);
+	local_irq_restore(flags);
+}
+
+static void nt_host_sync_irq(void *context)
+{
+	struct nt_host *h = context;
+
+	/* The core has dropped its IRQ spinlock and fenced controller access. */
+	if (READ_ONCE(h->core.fault))
+		nt_disable_irq(h);
+	if (h->irq_live)
+		synchronize_irq(h->irq);
+}
+
+static int nt_host_copy(void *context, struct nt_mmc_request *r,
+			unsigned char *buffer, int to_device)
+{
+	struct nt_request *request = container_of(r, struct nt_request, core);
+	struct mmc_data *data = request->mrq->data;
+	(void)context;
+	if (to_device)
+		return sg_copy_to_buffer(data->sg, data->sg_len, buffer, r->length);
+	return sg_copy_from_buffer(data->sg, data->sg_len, buffer, r->length);
+}
+
+static void nt_host_done(void *context, struct nt_mmc_request *r)
+{
+	struct nt_host *h = context;
+	struct nt_request *request = container_of(r, struct nt_request, core);
+	struct mmc_request *mrq = request->mrq;
+
+	/* A late halt/reset failure may occur after the first nonfatal fence. */
+	if (READ_ONCE(h->core.fault))
+		nt_mmc_irq_off(&h->core);
+	mrq->cmd->error = r->error;
+	memcpy(mrq->cmd->resp, r->resp, sizeof(r->resp));
+	if (mrq->data) {
+		mrq->data->error = r->error;
+		mrq->data->bytes_xfered = r->bytes;
+	}
+	/* Nothing owned by the request is accessed after its callback. */
+	kfree(request);
+	mmc_request_done(h->mmc, mrq);
+}
+
+static const struct nt_mmc_ops nt_ops = {
+	.read = nt_host_read,
+	.write = nt_host_write,
+	.now_us = nt_host_now,
+	.relax = nt_host_relax,
+	.lock = nt_host_lock,
+	.unlock = nt_host_unlock,
+	.irq_lock = nt_host_irq_lock,
+	.irq_unlock = nt_host_irq_unlock,
+	.sync_irq = nt_host_sync_irq,
+	.copy = nt_host_copy,
+	.done = nt_host_done,
+};
+
+static void nt_work(struct work_struct *work)
+{
+	struct nt_host *h = container_of(work, struct nt_host, work);
+	int error;
+	mutex_lock(&h->lock);
+	error = nt98513_mmc_clock_fault(h->clock);
+	if (error) {
+		h->core.fault = error;
+		nt_mmc_irq_off(&h->core);
+	}
+	mutex_unlock(&h->lock);
+	nt_mmc_run(&h->core);
+}
+
+static irqreturn_t nt_irq(int irq, void *context)
+{
+	struct nt_host *h = context;
+	int handled;
+
+	(void)irq;
+	/* A process-side fault may have fenced MMIO just before this IRQ ran. */
+	if (READ_ONCE(h->core.fault)) {
+		nt_disable_irq(h);
+		return IRQ_HANDLED;
+	}
+	handled = nt_mmc_irq(&h->core);
+	if (handled < 0)
+		nt_disable_irq(h);
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static void nt_request(struct mmc_host *mmc, struct mmc_request *mrq)
+{
+	struct nt_host *h = mmc_priv(mmc);
+	struct nt_request *request;
+	struct nt_mmc_request *r;
+	struct scatterlist *sg;
+	unsigned i, total = 0;
+	int error;
+
+	/* Reject a bad SG contract before the portable engine touches hardware. */
+	if (mrq->data) {
+		if (!mrq->data->sg || !mrq->data->sg_len || mrq->data->sg_len > 128 ||
+		    mrq->data->blocks != 1 || !mrq->data->blksz || mrq->data->blksz > 512 ||
+		    ((mrq->data->flags & (MMC_DATA_WRITE | MMC_DATA_READ)) != MMC_DATA_WRITE &&
+		     (mrq->data->flags & (MMC_DATA_WRITE | MMC_DATA_READ)) != MMC_DATA_READ)) {
+			error = -EINVAL;
+			goto reject;
+		}
+		for_each_sg(mrq->data->sg, sg, mrq->data->sg_len, i) {
+			if (sg->length > 512 - total) {
+				error = -EINVAL;
+				goto reject;
+			}
+			total += sg->length;
+		}
+		if (total != mrq->data->blksz) {
+			error = -EINVAL;
+			goto reject;
+		}
+	}
+	request = kzalloc(sizeof(*request), GFP_ATOMIC);
+	if (!request) {
+		error = -ENOMEM;
+		goto reject;
+	}
+	request->mrq = mrq;
+	r = &request->core;
+	r->opcode = mrq->cmd->opcode;
+	r->argument = mrq->cmd->arg;
+	r->response = mmc_resp_type(mrq->cmd);
+	r->busy_timeout_ms = mrq->cmd->busy_timeout;
+	r->sbc = !!mrq->sbc;
+	r->attached_stop = !!mrq->stop;
+	if (mrq->data) {
+		r->length = total;
+		r->blocks = mrq->data->blocks;
+		r->write = !!(mrq->data->flags & MMC_DATA_WRITE);
+		r->timeout_ns = mrq->data->timeout_ns;
+		r->timeout_clks = mrq->data->timeout_clks;
+	}
+	mutex_lock(&h->lock);
+	error = nt98513_mmc_clock_fault(h->clock);
+	if (error) {
+		h->core.fault = error;
+		nt_mmc_irq_off(&h->core);
+	}
+	mutex_unlock(&h->lock);
+	nt_mmc_submit(&h->core, r);
+	/* submit may complete/free r immediately. Never inspect it here. */
+	schedule_work(&h->work);
+	return;
+reject:
+	mrq->cmd->error = error;
+	if (mrq->data) {
+		mrq->data->error = error;
+		mrq->data->bytes_xfered = 0;
+	}
+	mmc_request_done(mmc, mrq);
+}
+
+static void nt_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	struct nt_host *h = mmc_priv(mmc);
+	unsigned actual;
+	int error;
+
+	mutex_lock(&h->lock);
+	if (h->core.fault)
+		goto out;
+	error = nt_mmc_ios_valid(ios->clock, ios->bus_width, ios->timing,
+				 ios->signal_voltage, ios->vdd);
+	if (!error)
+		error = nt98513_mmc_clock_fault(h->clock);
+	if (!error && h->core.active)
+		error = -EBUSY;
+	/* An OFF instance already passed stop/idle; do not read its registers. */
+	if (!error && h->core.rate)
+		error = nt_mmc_idle_locked(&h->core);
+	if (error)
+		goto fault;
+	if (!ios->clock) {
+		error = nt98513_mmc_clock_stop(h->clock);
+		if (!error) {
+			h->core.rate = 0;
+			mmc->actual_clock = 0;
+		}
+	} else {
+		error = nt98513_mmc_clock_rate(h->clock, ios->clock, &actual);
+		if (!error) {
+			h->core.rate = actual;
+			mmc->actual_clock = actual;
+		}
+	}
+fault:
+	if (error) {
+		h->core.fault = error;
+		nt_mmc_irq_off(&h->core);
+		dev_err(mmc_dev(mmc), "SD ios/clock fault %d; host offline\n", error);
+	}
+out:
+	mutex_unlock(&h->lock);
+}
+
+static const struct mmc_host_ops nt_host_ops = {
+	.request = nt_request,
+	.set_ios = nt_set_ios,
+	/* No card_busy callback: supported native SD paths poll CMD13 in core. */
+};
+
+static int nt_resources(struct platform_device *pdev, unsigned *index, int *irq)
+{
+	struct device_node *node = pdev->dev.of_node;
+	struct resource *r;
+	struct irq_data *data;
+	struct of_phandle_args spec;
+	u32 id, width, frequency;
+	int error;
+
+	if (!node || pdev->num_resources != 1 || of_irq_count(node) != 1 ||
+	    of_get_available_child_count(node) ||
+	    !of_property_read_bool(node, "openipc,linux-exclusive-ownership") ||
+	    !of_property_read_bool(node, "openipc,qualified-inherited-board-state") ||
+	    !of_property_read_bool(node, "openipc,stable-192mhz-parent") ||
+	    of_property_read_u32(node, "openipc,controller-index", &id) || id > 1 ||
+	    of_property_read_u32(node, "bus-width", &width) || width != 1 ||
+	    of_property_read_u32(node, "max-frequency", &frequency) || frequency != 12000000)
+		return -EINVAL;
+	r = platform_get_resource_byname(pdev, IORESOURCE_MEM, "host");
+	if (!r || r->start != (id ? 0xc0500000 : 0xc0420000) || resource_size(r) != 0x200)
+		return -EINVAL;
+	error = of_irq_parse_one(node, 0, &spec);
+	if (error)
+		return error;
+	error = spec.args_count != 1 || spec.args[0] != 30 + id ||
+		!of_device_is_compatible(spec.np, "openipc,nt98513-intc");
+	if (error) {
+		error = -EINVAL;
+		goto put_parent;
+	}
+	*irq = platform_get_irq(pdev, 0);
+	if (*irq <= 0) {
+		error = *irq ? *irq : -EINVAL;
+		goto put_parent;
+	}
+	data = irq_get_irq_data(*irq);
+	if (!data || !data->domain || irqd_to_hwirq(data) != 30 + id ||
+	    irq_domain_get_of_node(data->domain) != spec.np)
+		error = -EINVAL;
+put_parent:
+	of_node_put(spec.np);
+	if (error)
+		return error;
+	*index = id;
+	return 0;
+}
+
+static void nt_retire(struct nt_host *h)
+{
+	int error;
+	nt_mmc_stopping(&h->core);
+	if (h->registered) {
+		mmc_remove_host(h->mmc);
+		h->registered = false;
+	}
+	flush_work(&h->work);
+	/* Core power-off may already have stopped the bus clock. */
+	if (h->core.rate)
+		error = nt_mmc_shutdown(&h->core);
+	else
+		error = h->core.fault;
+	if (h->core.fault)
+		nt_mmc_irq_off(&h->core);
+	if (!error)
+		error = nt98513_mmc_clock_stop(h->clock);
+	if (!error)
+		error = nt98513_mmc_clock_release(h->clock);
+	if (h->irq_live) {
+		free_irq(h->irq, h);
+		h->irq_live = false;
+	}
+	if (error)
+		dev_err(mmc_dev(h->mmc), "SD shutdown fault %d; clock claim retained\n", error);
+}
+
+static int nt_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mmc_host *mmc;
+	struct nt_host *h;
+	unsigned index, actual;
+	int irq, error;
+
+	error = nt_resources(pdev, &index, &irq);
+	if (error)
+		return error;
+	mmc = mmc_alloc_host(sizeof(*h), dev);
+	if (!mmc)
+		return -ENOMEM;
+	h = mmc_priv(mmc);
+	h->mmc = mmc;
+	h->irq = irq;
+	atomic_set(&h->irq_disabled, 0);
+	mutex_init(&h->lock);
+	spin_lock_init(&h->irq_lock);
+	INIT_WORK(&h->work, nt_work);
+	nt_mmc_init(&h->core, &nt_ops, h);
+	h->clock = devm_nt98513_mmc_clock_get(dev, index);
+	if (IS_ERR(h->clock)) {
+		error = PTR_ERR(h->clock);
+		goto free_host;
+	}
+	/* Clock qualification precedes even the first controller read. */
+	error = nt98513_mmc_clock_admit(h->clock);
+	if (error)
+		goto free_host;
+	h->regs = devm_platform_ioremap_resource_byname(pdev, "host");
+	if (IS_ERR(h->regs)) {
+		error = PTR_ERR(h->regs);
+		goto release;
+	}
+	error = nt_mmc_admit(&h->core);
+	if (error)
+		goto release;
+	writel(0, h->regs + 0x30);
+	if (readl(h->regs + 0x30)) {
+		error = -EIO;
+		goto release;
+	}
+	error = nt98513_mmc_clock_start(h->clock, 400000, &actual);
+	if (error)
+		goto release;
+	error = nt_mmc_initialize(&h->core, actual);
+	if (error)
+		goto retire;
+	error = request_irq(irq, nt_irq, 0, dev_name(dev), h);
+	if (error)
+		goto retire;
+	h->irq_live = true;
+	mmc->ops = &nt_host_ops;
+	mmc->f_min = 400000;
+	mmc->f_max = 12000000;
+	mmc->actual_clock = actual;
+	mmc->ocr_avail = MMC_VDD_32_33 | MMC_VDD_33_34;
+	mmc->caps = MMC_CAP_NEEDS_POLL;
+	mmc->caps2 = MMC_CAP2_NO_SDIO | MMC_CAP2_NO_MMC;
+	mmc->max_blk_count = 1;
+	mmc->max_blk_size = 512;
+	mmc->max_req_size = 512;
+	mmc->max_seg_size = 512;
+	mmc->max_segs = 128;
+	platform_set_drvdata(pdev, h);
+	error = mmc_add_host(mmc);
+	if (error)
+		goto retire;
+	h->registered = true;
+	return 0;
+retire:
+	nt_retire(h);
+	goto free_host;
+release:
+	/* A failed initialized clock operation retains its sticky claim. */
+	nt98513_mmc_clock_release(h->clock);
+free_host:
+	mmc_free_host(mmc);
+	return error;
+}
+
+static void nt_shutdown(struct platform_device *pdev)
+{
+	nt_retire(platform_get_drvdata(pdev));
+}
+
+static int nt_remove(struct platform_device *pdev)
+{
+	struct nt_host *h = platform_get_drvdata(pdev);
+	nt_retire(h);
+	mmc_free_host(h->mmc);
+	return 0;
+}
+
+static const struct of_device_id nt_match[] = {
+	{ .compatible = "openipc,nt98513-mmc-pio-v1" },
+	{ }
+};
+
+static struct platform_driver nt_driver = {
+	.probe = nt_probe,
+	.remove = nt_remove,
+	.shutdown = nt_shutdown,
+	.driver = {
+		.name = "nt98513-mmc-pio",
+		.of_match_table = nt_match,
+		.suppress_bind_attrs = true,
+	},
+};
