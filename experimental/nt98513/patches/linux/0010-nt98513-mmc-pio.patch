--- /dev/null
+++ b/Documentation/devicetree/bindings/mmc/openipc,nt98513-mmc-pio.yaml
@@ -0,0 +1,68 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mmc/openipc,nt98513-mmc-pio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Experimental NT98513 inherited-board native SD PIO host
+maintainers:
+  - OpenIPC Developers <dev@openipc.org>
+description: |
+  Two declared controller instances, no proven physical socket mapping.
+  Native SD only, 1-bit 3.3V, single blocks up to512 bytes, nominal400kHz..12MHz.
+  The permanent shared-clock-v3 supplier owns all CG and CC arbitration.
+  No pad/power initialization or DMA. Deployment assertions require separately
+  qualified physical ownership, previous DMA quiescence, routing and electrical
+  readiness; neither booleans nor readable idle bits prove those facts.
+properties:
+  compatible:
+    const: openipc,nt98513-mmc-pio-v1
+  reg:
+    maxItems: 1
+  reg-names:
+    const: host
+  interrupts:
+    maxItems: 1
+  interrupt-names:
+    const: host
+  openipc,controller-index:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [0, 1]
+  openipc,clock-owner:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Permanent shared-clock-v3 owner, also referencing the sole CC bank.
+  bus-width:
+    const: 1
+  max-frequency:
+    const: 12000000
+  openipc,linux-exclusive-ownership:
+    type: boolean
+    description: Previous controller/IRQ/DMA masters quiesced and excluded for the lifetime.
+  openipc,qualified-inherited-board-state:
+    type: boolean
+    description: Independently qualified card power, 3.3V pads, drive and route for this instance.
+  openipc,stable-192mhz-parent:
+    type: boolean
+    description: Parent0 is stable nominal192MHz; selected clock fields have no competing writer.
+  status: true
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - openipc,controller-index
+  - openipc,clock-owner
+  - bus-width
+  - max-frequency
+allOf:
+  - if:
+      properties:
+        status:
+          const: disabled
+      required: [status]
+    else:
+      required:
+        - openipc,linux-exclusive-ownership
+        - openipc,qualified-inherited-board-state
+        - openipc,stable-192mhz-parent
+additionalProperties: false
--- a/arch/mips/boot/dts/nt98513/Makefile
+++ b/arch/mips/boot/dts/nt98513/Makefile
@@ -1,5 +1,7 @@
 include $(srctree)/arch/mips/nt98513/clock-config-guard.mk
-ifeq ($(CONFIG_NT98513_USB_HOST_BOARD),y)
+ifeq ($(CONFIG_NT98513_MMC_BOARD),y)
+dtb-$(CONFIG_MACH_NT98513) += nt98513-mmc.dtb
+else ifeq ($(CONFIG_NT98513_USB_HOST_BOARD),y)
 dtb-$(CONFIG_MACH_NT98513) += nt98513-usb-host.dtb
 else ifeq ($(CONFIG_NT98513_ETHERNET_BOARD),y)
 dtb-$(CONFIG_MACH_NT98513) += nt98513-ethernet.dtb
