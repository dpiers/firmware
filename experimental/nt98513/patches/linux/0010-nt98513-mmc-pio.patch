--- /dev/null
+++ b/drivers/mmc/host/nt98513/Makefile
@@ -0,0 +1,3 @@
+# SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_MMC_NT98513) += nt98513-mmc.o
+nt98513-mmc-y := nt98513-mmc-core.o nt98513-mmc-driver.o
--- /dev/null
+++ b/drivers/mmc/host/nt98513/nt98513-mmc-core.c
@@ -0,0 +1,511 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Authored NT98513 SD PIO engine. No DMA, pad or shared-clock register access. */
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/math64.h>
+#include <linux/string.h>
+#else
+#include <errno.h>
+#include <string.h>
+#endif
+#include "nt98513-mmc.h"
+
+#define NT_STATUS_MASK 0xffU
+#define NT_READ_FAULT 0x80000000U
+#define NT_COMMAND_US 1000000ULL
+#define NT_DATA_US 10000000ULL
+#define NT_RESET_US 20000ULL
+
+static int nt_read(struct nt_mmc *c, unsigned reg, unsigned *value)
+{
+	*value = c->ops->read(c->context, reg);
+	if (*value == ~0U) {
+		c->fault = -EIO;
+		return -EIO;
+	}
+	return 0;
+}
+
+static void nt_write(struct nt_mmc *c, unsigned reg, unsigned value)
+{
+	c->ops->write(c->context, reg, value);
+}
+
+static int nt_poll_clear(struct nt_mmc *c, unsigned reg, unsigned mask,
+			 unsigned long long deadline)
+{
+	unsigned value;
+	for (;;) {
+		if (c->ops->now_us(c->context) >= deadline)
+			return -ETIMEDOUT;
+		if (nt_read(c, reg, &value))
+			return -EIO;
+		if (!(value & mask))
+			return 0;
+		if (c->ops->now_us(c->context) >= deadline)
+			return -ETIMEDOUT;
+		c->ops->relax(c->context);
+	}
+}
+
+void nt_mmc_init(struct nt_mmc *c, const struct nt_mmc_ops *ops, void *context)
+{
+	memset(c, 0, sizeof(*c));
+	c->ops = ops;
+	c->context = context;
+}
+
+int nt_mmc_idle_locked(struct nt_mmc *c)
+{
+	unsigned command, transfer;
+	if (nt_read(c, 0, &command) || nt_read(c, 0x10c, &transfer))
+		return -EIO;
+	return ((command & 0x600) || (transfer & 3)) ? -EBUSY : 0;
+}
+
+int nt_mmc_admit(struct nt_mmc *c)
+{
+	int error;
+	c->ops->lock(c->context);
+	error = nt_mmc_idle_locked(c);
+	if (!error)
+		c->admitted = 1;
+	c->ops->unlock(c->context);
+	return error;
+}
+
+void nt_mmc_irq_off(struct nt_mmc *c)
+{
+	unsigned long flags = c->ops->irq_lock(c->context);
+	c->irq_access = 0;
+	c->ops->irq_unlock(c->context, flags);
+	c->ops->sync_irq(c->context);
+}
+
+static int nt_drain(struct nt_mmc *c)
+{
+	unsigned long flags;
+	unsigned value;
+	int error = 0;
+
+	/* Keep a pending level IRQ excluded until its accessible source is masked.
+	 * A failed readback publishes the terminal fault before IRQs can resume.
+	 */
+	flags = c->ops->irq_lock(c->context);
+	c->irq_access = 0;
+	nt_write(c, 0x30, 0);
+	if (nt_read(c, 0x30, &value) || value) {
+		c->fault = -EIO;
+		error = -EIO;
+	} else {
+		nt_write(c, 0x28, NT_STATUS_MASK);
+		c->pending = 0;
+	}
+	c->ops->irq_unlock(c->context, flags);
+	c->ops->sync_irq(c->context);
+	return error;
+}
+
+/* Stop the PIO engine before any request buffer can be returned to MMC core. */
+static int nt_halt(struct nt_mmc *c, unsigned long long deadline)
+{
+	unsigned value;
+	if (nt_drain(c))
+		return -EIO;
+	nt_write(c, 0x10c, 0);
+	if (nt_poll_clear(c, 0x10c, 1, deadline) || nt_read(c, 0x1c, &value))
+		return -EIO;
+	nt_write(c, 0x1c, value & ~0x40U);
+	return nt_poll_clear(c, 0, 0x600, deadline);
+}
+
+static int nt_reset(struct nt_mmc *c, unsigned long long deadline)
+{
+	unsigned value;
+	unsigned long long settle;
+	if (nt_drain(c))
+		return -EIO;
+	nt_write(c, 0x10c, 0);
+	if (nt_poll_clear(c, 0x10c, 1, deadline) || nt_read(c, 0x1c, &value))
+		return -EIO;
+	nt_write(c, 0x1c, value & ~0x40U);
+	if (nt_read(c, 0, &value))
+		return -EIO;
+	nt_write(c, 0, value | 0x400);
+	if (nt_poll_clear(c, 0, 0x600, deadline) || nt_read(c, 0x1b0, &value))
+		return -EIO;
+	nt_write(c, 0x1b0, value | 0x10);
+	nt_write(c, 0x44, 0x140000);
+	nt_write(c, 0x50, 0x2020);
+	if (nt_read(c, 0x4c, &value))
+		return -EIO;
+	nt_write(c, 0x4c, value | 1);
+	if (nt_poll_clear(c, 0x4c, 1, deadline) || nt_read(c, 0x54, &value))
+		return -EIO;
+	nt_write(c, 0x54, (value & 0x0fffffff) | 0xa0000000);
+	if (nt_read(c, 0x4c, &value))
+		return -EIO;
+	nt_write(c, 0x4c, value | 0x10);
+	settle = c->ops->now_us(c->context) + 1024;
+	while (c->ops->now_us(c->context) < settle) {
+		if (c->ops->now_us(c->context) >= deadline)
+			return -ETIMEDOUT;
+		c->ops->relax(c->context);
+	}
+	if (c->ops->now_us(c->context) >= deadline)
+		return -ETIMEDOUT;
+	return nt_drain(c);
+}
+
+int nt_mmc_initialize(struct nt_mmc *c, unsigned rate)
+{
+	unsigned value;
+	int error = -EINVAL;
+	c->ops->lock(c->context);
+	if (!c->admitted || rate < 400000 || rate > 12000000)
+		goto out;
+	error = nt_reset(c, c->ops->now_us(c->context) + NT_RESET_US);
+	if (!error)
+		error = nt_read(c, 0x3c, &value);
+	if (!error) {
+		nt_write(c, 0x3c, value & ~3U);
+		c->rate = rate;
+		c->initialized = 1;
+	}
+	if (error)
+		c->fault = error;
+out:
+	c->ops->unlock(c->context);
+	return error;
+}
+
+/* Linux power-off and power-up legitimately use clock0/vdd0. */
+int nt_mmc_ios_valid(unsigned clock, unsigned width, unsigned timing,
+		     unsigned signal_voltage, unsigned vdd)
+{
+	if (width || timing || signal_voltage)
+		return -EINVAL;
+	if (!clock)
+		return 0;
+	if (clock < 400000 || clock > 12000000 || (vdd != 20 && vdd != 21))
+		return -EINVAL;
+	return 0;
+}
+
+static int nt_validate(struct nt_mmc_request *r)
+{
+	if (r->opcode > 63 || r->attached_stop || r->sbc || r->write > 1)
+		return -EINVAL;
+	if (r->response != 0 && r->response != 1 && r->response != 7 &&
+	    r->response != 21 && r->response != 29)
+		return -EOPNOTSUPP;
+	if (r->response == 29 && r->opcode != 12 && r->opcode != 38)
+		return -EOPNOTSUPP;
+	if (r->opcode == 1 || r->opcode == 5 || r->opcode == 11 ||
+	    r->opcode == 18 || r->opcode == 19 || r->opcode == 21 ||
+	    r->opcode == 25 || r->opcode == 52 || r->opcode == 53)
+		return -EOPNOTSUPP;
+	if (r->length > 512 || (r->length ? r->blocks != 1 : r->blocks != 0))
+		return -EINVAL;
+	return 0;
+}
+
+void nt_mmc_submit(struct nt_mmc *c, struct nt_mmc_request *r)
+{
+	int error;
+	memset(r->resp, 0, sizeof(r->resp));
+	r->bytes = 0;
+	r->error = 0;
+	c->ops->lock(c->context);
+	error = nt_validate(r);
+	if (!error && (c->stopping || c->fault || !c->initialized || !c->rate))
+		error = c->fault ? c->fault : -ESHUTDOWN;
+	if (!error && c->active)
+		error = -EBUSY;
+	if (!error) {
+		r->submitted_us = c->ops->now_us(c->context);
+		c->active = r;
+	} else
+		r->error = error;
+	c->ops->unlock(c->context);
+	if (error)
+		c->ops->done(c->context, r);
+}
+
+int nt_mmc_irq(struct nt_mmc *c)
+{
+	unsigned status;
+	unsigned long flags;
+	int handled;
+	flags = c->ops->irq_lock(c->context);
+	if (!c->irq_access) {
+		c->ops->irq_unlock(c->context, flags);
+		return 0;
+	}
+	status = c->ops->read(c->context, 0x28);
+	if (status == ~0U) {
+		c->fault = -EIO;
+		c->pending |= NT_READ_FAULT;
+		c->irq_access = 0;
+		handled = -EIO;
+	} else {
+		status &= NT_STATUS_MASK;
+		handled = !!status;
+		if (status) {
+			nt_write(c, 0x28, status);
+			c->pending |= status;
+		}
+	}
+	c->ops->irq_unlock(c->context, flags);
+	return handled;
+}
+
+/* Polling also handles a lost interrupt; both readers share the IRQ lock. */
+static unsigned nt_events(struct nt_mmc *c)
+{
+	unsigned status, events;
+	unsigned long flags;
+	flags = c->ops->irq_lock(c->context);
+	if (c->pending & NT_READ_FAULT) {
+		c->fault = -EIO;
+		c->irq_access = 0;
+		events = c->pending;
+		c->pending = 0;
+		c->ops->irq_unlock(c->context, flags);
+		return events;
+	}
+	status = c->ops->read(c->context, 0x28);
+	if (status == ~0U) {
+		c->fault = -EIO;
+		c->irq_access = 0;
+		c->pending |= NT_READ_FAULT;
+	} else if (status & NT_STATUS_MASK) {
+		nt_write(c, 0x28, status & NT_STATUS_MASK);
+		c->pending |= status & NT_STATUS_MASK;
+	}
+	events = c->pending;
+	c->pending = 0;
+	c->ops->irq_unlock(c->context, flags);
+	return events;
+}
+
+static int nt_fifo(struct nt_mmc *c, struct nt_mmc_request *r, unsigned *offset)
+{
+	unsigned value, remaining = (r->length - *offset + 3) / 4;
+	unsigned words = remaining > 32 ? 32 : remaining, i, j;
+	if (!words)
+		return 0;
+	if (nt_read(c, 0x108, &value))
+		return -EIO;
+	if (r->write) {
+		if (!(value & 0x100))
+			return 0;
+	} else if (words == 32 ? !(value & 0x200) : (value & 0x3f) != words) {
+		return 0;
+	}
+	for (i = 0; i < words; i++) {
+		unsigned at = *offset + i * 4;
+		if (r->write) {
+			value = 0;
+			for (j = 0; j < 4 && at + j < r->length; j++)
+				value |= (unsigned)c->bounce[at + j] << (j * 8);
+			nt_write(c, 0x100, value);
+		} else {
+			/* FIFO payload0xffffffff is valid data, not an MMIO fault. */
+			value = c->ops->read(c->context, 0x100);
+			for (j = 0; j < 4 && at + j < r->length; j++)
+				c->bounce[at + j] = value >> (j * 8);
+		}
+	}
+	*offset += words * 4;
+	if (*offset > r->length)
+		*offset = r->length;
+	return 0;
+}
+
+static int nt_launch(struct nt_mmc *c, struct nt_mmc_request *r)
+{
+	unsigned value, count, i, response = r->response == 7 ? 0xc0 : r->response ? 0x40 : 0;
+	unsigned long long ticks;
+	unsigned long flags;
+	if (nt_read(c, 0, &value))
+		return -EIO;
+	if (value & 0x600)
+		return -EBUSY;
+	if (r->length) {
+		/* Recovered read-spacing sequence is not a timed readiness proof. */
+		count = c->rate >= 12000000 ? 21 : 9;
+		for (i = 0; i < count + 2; i++)
+			if (nt_read(c, 0, &value))
+				return -EIO;
+		ticks = (unsigned long long)r->timeout_ns * c->rate + 999999999;
+#ifdef __KERNEL__
+		ticks = div_u64(ticks, 1000000000);
+#else
+		ticks /= 1000000000;
+#endif
+		ticks += r->timeout_clks;
+		if (!ticks)
+			ticks = c->rate;
+		if (ticks > 0xffffffffULL)
+			ticks = 0xffffffffULL;
+		nt_write(c, 0x20, (unsigned)ticks);
+		if (nt_read(c, 0x1c, &value))
+			return -EIO;
+		nt_write(c, 0x1c, (value & 0xffffU & ~0x2240U) |
+			 (r->length << 16) | 0x40);
+		nt_write(c, 0x104, r->length);
+		nt_write(c, 0x10c, r->write ? 4 : 0);
+		nt_write(c, 0x10c, r->write ? 5 : 1);
+	}
+	nt_write(c, 4, r->argument);
+	if (nt_read(c, 0, &value))
+		return -EIO;
+	value = (value & ~0xbffU) | response | r->opcode;
+	nt_write(c, 0, value);
+	flags = c->ops->irq_lock(c->context);
+	c->irq_access = 1;
+	nt_write(c, 0x30, NT_STATUS_MASK);
+	nt_write(c, 0, value | 0x200);
+	c->ops->irq_unlock(c->context, flags);
+	return 0;
+}
+
+void nt_mmc_run(struct nt_mmc *c)
+{
+	struct nt_mmc_request *r;
+	unsigned status, offset = 0, value, i;
+	unsigned long long start, command_deadline, deadline;
+	int error = 0, command_done = 0, data_done = 0, service = 0;
+
+	c->ops->lock(c->context);
+	r = c->active;
+	if (!r) {
+		c->ops->unlock(c->context);
+		return;
+	}
+	if (c->fault || !c->rate) {
+		error = c->fault ? c->fault : -ESHUTDOWN;
+		goto notify;
+	}
+	if (c->ops->now_us(c->context) >= r->submitted_us + NT_COMMAND_US) {
+		error = -ETIMEDOUT;
+		goto notify;
+	}
+	memset(c->bounce, 0, sizeof(c->bounce));
+	if (r->length && r->write && c->ops->copy(c->context, r, c->bounce, 1) != (int)r->length) {
+		error = -EINVAL;
+		goto notify;
+	}
+	error = nt_drain(c);
+	if (error)
+		goto notify;
+	start = r->submitted_us;
+	command_deadline = start + NT_COMMAND_US;
+	deadline = start + (r->length ? NT_DATA_US : NT_COMMAND_US);
+	if (r->length) {
+		for (;;) {
+			if (c->ops->now_us(c->context) >= command_deadline) {
+				error = -ETIMEDOUT;
+				break;
+			}
+			error = nt_read(c, 0x40, &value);
+			if (error || (value & 1))
+				break;
+			c->ops->relax(c->context);
+		}
+	}
+	/* Admission and the final readiness read also consume this deadline. */
+	if (!error && c->ops->now_us(c->context) >= command_deadline)
+		error = -ETIMEDOUT;
+	if (!error)
+		error = nt_launch(c, r);
+	while (!error) {
+		if (c->ops->now_us(c->context) >= deadline ||
+		    (!command_done && c->ops->now_us(c->context) >= command_deadline)) {
+			error = -ETIMEDOUT;
+			break;
+		}
+		status = nt_events(c);
+		if (status & NT_READ_FAULT) {
+			error = -EIO;
+			c->fault = error;
+			break;
+		}
+		if (status & 0xc) {
+			error = -ETIMEDOUT;
+			break;
+		}
+		if ((status & 2) || ((status & 1) && (r->response & 4))) {
+			error = -EILSEQ;
+			break;
+		}
+		if ((status & (r->length ? 0x10 : 0x50)) ||
+		    ((status & 1) && !(r->response & 4)))
+			command_done = 1;
+		if (status & 0xa0)
+			data_done = 1;
+		if (status & 0x50)
+			service = 1;
+		if (r->length && service && offset < r->length)
+			error = nt_fifo(c, r, &offset);
+		if (error || (command_done && (!r->length || (data_done && offset == r->length))))
+			break;
+		if (c->ops->now_us(c->context) >= deadline ||
+		    (!command_done && c->ops->now_us(c->context) >= command_deadline)) {
+			error = -ETIMEDOUT;
+			break;
+		}
+		c->ops->relax(c->context);
+	}
+	/* Response words may legitimately contain all ones. */
+	if (!error && r->response) {
+		if (r->response == 7)
+			for (i = 0; i < 4; i++)
+				r->resp[3 - i] = c->ops->read(c->context, 8 + 4 * i);
+		else
+			r->resp[0] = c->ops->read(c->context, 8);
+	}
+	deadline = c->ops->now_us(c->context) + NT_RESET_US;
+	if (c->fault) {
+		nt_mmc_irq_off(c);
+		error = c->fault;
+	} else if (error ? nt_reset(c, deadline) : nt_halt(c, deadline)) {
+		c->fault = -EIO;
+		error = -EIO;
+	}
+	if (!error && r->length && !r->write &&
+	    c->ops->copy(c->context, r, c->bounce, 0) != (int)r->length)
+		error = -EINVAL;
+notify:
+	r->error = error;
+	r->bytes = error ? 0 : r->length;
+	c->active = NULL;
+	c->ops->unlock(c->context);
+	/* Callback can free r and synchronously submit the next request. */
+	c->ops->done(c->context, r);
+}
+
+void nt_mmc_stopping(struct nt_mmc *c)
+{
+	c->ops->lock(c->context);
+	c->stopping = 1;
+	c->ops->unlock(c->context);
+}
+
+int nt_mmc_shutdown(struct nt_mmc *c)
+{
+	int error;
+	c->ops->lock(c->context);
+	c->stopping = 1;
+	if (c->active)
+		error = -EBUSY;
+	else if (c->fault)
+		error = c->fault;
+	else
+		error = nt_halt(c, c->ops->now_us(c->context) + NT_RESET_US);
+	if (error)
+		c->fault = error;
+	c->ops->unlock(c->context);
+	return error;
+}
