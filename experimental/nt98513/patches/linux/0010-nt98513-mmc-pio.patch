@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "nt98513-usb-host.dts"
+
+&clock_owner {
+ compatible = "openipc,nt98513-shared-clock-v3";
+ reg = <0xc0020074 4>, <0xc0020084 4>, <0xc0020020 4>,
+       <0xc002003c 4>, <0xc00200b0 4>;
+ reg-names = "gate", "prepare", "mux", "divider", "phase";
+};
+
+/ {
+ mmc0: mmc@c0420000 {
+  compatible = "openipc,nt98513-mmc-pio-v1";
+  reg = <0xc0420000 0x200>;
+  reg-names = "host";
+  interrupt-parent = <&intc>;
+  interrupts = <30>;
+  interrupt-names = "host";
+  openipc,controller-index = <0>;
+  openipc,clock-owner = <&clock_owner>;
+  bus-width = <1>;
+  max-frequency = <12000000>;
+  /* Neither this node nor its address establishes the physical socket. */
+  status = "disabled";
+ };
+ mmc1: mmc@c0500000 {
+  compatible = "openipc,nt98513-mmc-pio-v1";
+  reg = <0xc0500000 0x200>;
+  reg-names = "host";
+  interrupt-parent = <&intc>;
+  interrupts = <31>;
+  interrupt-names = "host";
+  openipc,controller-index = <1>;
+  openipc,clock-owner = <&clock_owner>;
+  bus-width = <1>;
+  max-frequency = <12000000>;
+  status = "disabled";
+ };
+};
