+endif
+ifneq ($(CONFIG_NT98513_MMC_BOARD),y)
+$(error NT98513 MMC configuration requires CONFIG_NT98513_MMC_BOARD=y)
+endif
+ifneq ($(CONFIG_MMC_NT98513),y)
+$(error NT98513 MMC configuration requires CONFIG_MMC_NT98513=y)
