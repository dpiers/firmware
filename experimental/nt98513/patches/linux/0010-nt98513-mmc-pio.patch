@@ -1071,3 +1071,15 @@
 	  module will be called litex_mmc.
 
 	  If unsure, say N.
+
+config MMC_NT98513
+ bool "Experimental NT98513 native SD single-block PIO host"
+ depends on MACH_NT98513 && OF && MMC=y && MMC_BLOCK=y
+ depends on NT98513_SHARED_CLOCK && NT98513_CC_BANK
+ depends on !PM && !SMP && !OF_DYNAMIC
+ default n
+ help
+   Permanent native SD host, 1-bit 3.3-V and at most nominal12MHz.
+   Requires qualified inherited power/pads, stable parent and exclusive
+   ownership. No DMA, SDIO/eMMC, tuning or voltage switching. Both supplied
+   board nodes stay disabled; software assertions do not prove readiness.
