+ifneq ($(CONFIG_MMC_BLOCK),y)
+$(error NT98513 MMC configuration requires CONFIG_MMC_BLOCK=y)
+endif
+ifneq ($(CONFIG_NT98513_USB_HOST_BOARD),y)
+$(error NT98513 MMC configuration requires CONFIG_NT98513_USB_HOST_BOARD=y)
+endif
+ifneq ($(CONFIG_NT98513_SHARED_CLOCK),y)
+$(error NT98513 MMC configuration requires CONFIG_NT98513_SHARED_CLOCK=y)
+endif
+ifneq ($(CONFIG_NT98513_CC_BANK),y)
+$(error NT98513 MMC configuration requires CONFIG_NT98513_CC_BANK=y)
+endif
+ifneq ($(CONFIG_OF),y)
+$(error NT98513 MMC configuration requires CONFIG_OF=y)
+endif
+ifneq ($(filter-out n,$(CONFIG_PM)),)
+$(error NT98513 MMC configuration requires CONFIG_PM=n)
+endif
+ifneq ($(filter-out n,$(CONFIG_SMP)),)
+$(error NT98513 MMC configuration requires CONFIG_SMP=n)
+endif
+ifneq ($(filter-out n,$(CONFIG_OF_DYNAMIC)),)
+$(error NT98513 MMC configuration requires CONFIG_OF_DYNAMIC=n)
+endif
+endif
