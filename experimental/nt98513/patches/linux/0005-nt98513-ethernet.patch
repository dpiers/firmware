--- /dev/null
+++ b/drivers/net/ethernet/stmicro/stmmac/stmmac-csr-policy.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef STMMAC_CSR_POLICY_H
+#define STMMAC_CSR_POLICY_H
+/* An activation-only clock has no timing information. Never underflow. */
+static inline int stmmac_csr_tick(unsigned long rate, int unknown,
+				unsigned int *tick)
+{
+	if (unknown || rate < 1000000)
+		return 0;
+	*tick = rate / 1000000 - 1;
+	return 1;
+}
+#endif
