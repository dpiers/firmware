--- /dev/null
+++ b/Documentation/devicetree/bindings/net/openipc,nt98513-ethernet.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/openipc,nt98513-ethernet.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: Experimental NT98513 inherited-state Ethernet
+maintainers:
+  - Daniel Piers <dpiers@users.noreply.github.com>
+description: |
+  Conditional DWMAC4 candidate based on recovered software behavior. Activation
+  requires Linux-exclusive MAC/IRQ ownership and independently supplied MII/RMII
+  board wiring. Runtime accepts MAC IDs 0x40 and 0x41 only. PHY identity/address
+  are discovered by generic Clause22 MDIO; no PHY/reset/fixed-link child is
+  admitted. The clock is activation-only, with unknown physical rate. The
+  separate C02B3008 read/nonzero ISR precheck is an experimental compatibility
+  hypothesis; its hardware role and side effects are not established. TOP bit18
+  and DGPIO bits0/1 must already be clear; this driver never changes them.
+  Ownership checks do not exclude later peer writes. Standard stmmac DMA
+  stop/free behavior, IRQ delivery and physical clocks remain unvalidated.
+properties:
+  compatible:
+    const: openipc,nt98513-ethernet-v1
+  reg:
+    items:
+      - description: MAC C02B0000, 0x2010 bytes
+      - description: Observed interrupt precheck C02B3008, four bytes
+      - description: Inherited TOP C0011000, four bytes
+      - description: Inherited DGPIO C00100D0, four bytes
+  reg-names:
+    items:
+      - const: mac
+      - const: irq-summary
+      - const: inherited-top
+      - const: inherited-dgpio
+  interrupts:
+    maxItems: 1
+    description: INTC hardware IRQ34, not Linux virtual IRQ34
+  interrupt-parent: true
+  interrupt-names:
+    const: macirq
+  clocks:
+    maxItems: 1
+    description: Existing shared-clock-v2 activation client1
+  clock-names:
+    const: stmmaceth
+  openipc,cc-bank:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Same permanent shared CC bank referenced by the clock provider
+  openipc,linux-exclusive-ownership:
+    type: boolean
+    description: Boot contract excludes peer MAC/DMA and IRQ34 access for this boot
+  phy-mode:
+    enum: [mii, rmii]
+    description: Independently established physical board interface
+  mac-address:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 6
+    maxItems: 6
+  local-mac-address:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 6
+    maxItems: 6
+  status:
+    enum: [okay, disabled, reserved]
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - interrupt-names
+  - clocks
+  - clock-names
+  - openipc,cc-bank
+anyOf:
+  - properties:
+      status:
+        enum: [disabled, reserved]
+    required: [status]
+  - required: [phy-mode, 'openipc,linux-exclusive-ownership']
+additionalProperties: false
--- a/arch/mips/boot/dts/nt98513/Makefile
