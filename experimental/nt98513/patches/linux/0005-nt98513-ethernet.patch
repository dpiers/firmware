+// SPDX-License-Identifier: GPL-2.0-only
+#include "nt98513-shared-clock.dts"
+
+/ {
+ ethernet: ethernet@c02b0000 {
+  compatible = "openipc,nt98513-ethernet-v1";
+  reg = <0xc02b0000 0x2010>, <0xc02b3008 4>,
+        <0xc0011000 4>, <0xc00100d0 4>;
+  reg-names = "mac", "irq-summary", "inherited-top", "inherited-dgpio";
+  interrupt-parent = <&intc>;
+  interrupts = <34>;
+  interrupt-names = "macirq";
+  clocks = <&clock_owner 1>;
+  clock-names = "stmmaceth";
+  openipc,cc-bank = <&cc_bank>;
+  /* Board phy-mode and explicit ownership must be supplied before enabling.
+   * There is intentionally no generic fallback compatible or fixed link.
+   */
+  status = "disabled";
+ };
+};
