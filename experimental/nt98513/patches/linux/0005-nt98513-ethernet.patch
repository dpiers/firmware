--- /dev/null
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-nt98513-policy.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef DWMAC_NT98513_POLICY_H
+#define DWMAC_NT98513_POLICY_H
+/* Portable production policy; errno definitions supplied by the consumer. */
+struct nt98513_eth_input {
+	int exclusive, mode_ok, irqs, resources, unsupported, clock_ok, raw_irq_ok;
+};
+static inline int nt98513_eth_validate(const struct nt98513_eth_input *in)
+{
+	if (!in->exclusive)
+		return -EPERM;
+	if (!in->mode_ok || in->irqs != 1 || in->resources != 4 ||
+	    in->unsupported || !in->clock_ok || !in->raw_irq_ok)
+		return -EINVAL;
+	return 0;
+}
+static inline int nt98513_eth_resource(unsigned int index,
+				      unsigned long long start,
+				      unsigned long long size)
+{
+	static const unsigned long long starts[] = {
+		0xc02b0000, 0xc02b3008, 0xc0011000, 0xc00100d0
+	};
+	return index < 4 && start == starts[index] &&
+		size == (index ? 4 : 0x2010);
+}
+struct nt98513_eth_ops {
+	int (*enable)(void *);
+	int (*fault)(void *);
+	unsigned int (*top)(void *);
+	unsigned int (*pads)(void *);
+	unsigned int (*version)(void *);
+};
+static inline int nt98513_eth_activate(const struct nt98513_eth_ops *ops, void *p)
+{
+	int ret = ops->enable(p);
+	unsigned int version;
+
+	if (ret)
+		return ret;
+	ret = ops->fault(p);
+	if (ret)
+		return ret;
+	if (ops->top(p) & (1U << 18))
+		return -EBUSY;
+	if (ops->pads(p) & 3U)
+		return -EBUSY;
+	/* Explicitly admit only upstream DWMAC 4.00/4.10 IDs, never ID0 fallback.
+	 * Upper version bits are the integrator's user ID, not an IP revision.
+	 */
+	version = ops->version(p) & 0xff;
+	return version == 0x40 || version == 0x41 ? 0 : -ENODEV;
+}
+static inline int nt98513_eth_irq_pending(unsigned int summary)
+{
+	return summary != 0;
+}
+#endif
--- /dev/null
+++ b/drivers/net/ethernet/stmicro/stmmac/dwmac-nt98513.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Experimental NT98513 inherited-state DWMAC4 candidate.
+ * C02B3008's read/nonzero test is recovered software behavior, not a proved
+ * register definition. Ownership, physical clocks, board wiring and upstream
+ * DMA stop/free semantics remain hardware validation requirements.
+ */
+#include <linux/clk.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/of_clk.h>
+#include <linux/of_irq.h>
+#include <linux/of_net.h>
+#include <linux/platform_device.h>
+#include <linux/soc/nt98513_cc_bank.h>
+#include "stmmac_platform.h"
+#include "dwmac-nt98513-policy.h"
+
+struct nt98513_eth {
+	struct device *dev;
+	struct clk *clock;
+	struct nt98513_cc_bank *bank;
+	void __iomem *mac, *summary, *top, *pads;
+};
+
+static void nt98513_eth_clock_put(void *p)
+{
+	/* The established CCF provider's disable/unprepare are sticky no-ops. */
+	clk_disable_unprepare(p);
+}
+
+static int nt98513_eth_enable(void *p)
+{
+	struct nt98513_eth *eth = p;
+	int ret = clk_prepare_enable(eth->clock);
+
+	if (ret)
+		return ret;
+	return devm_add_action_or_reset(eth->dev, nt98513_eth_clock_put, eth->clock);
+}
+
+static int nt98513_eth_fault(void *p)
+{
+	struct nt98513_eth *eth = p;
+
+	/* Fresh supplier snapshot even when CCF reused a prepared clock. */
+	return nt_cc_status(eth->bank);
+}
+
+static unsigned int nt98513_eth_top(void *p)
+{
+	return readl(((struct nt98513_eth *)p)->top);
+}
+
+static unsigned int nt98513_eth_pads(void *p)
+{
+	return readl(((struct nt98513_eth *)p)->pads);
+}
+
+static unsigned int nt98513_eth_version(void *p)
+{
+	return readl(((struct nt98513_eth *)p)->mac + 0x110);
+}
+
+static const struct nt98513_eth_ops nt98513_eth_ops = {
+	.enable = nt98513_eth_enable,
+	.fault = nt98513_eth_fault,
+	.top = nt98513_eth_top,
+	.pads = nt98513_eth_pads,
+	.version = nt98513_eth_version,
+};
+
+static bool nt98513_eth_pending(void *p)
+{
+	struct nt98513_eth *eth = p;
+
+	/* Do not acknowledge, mask or reinterpret the observed boolean test. */
+	return nt98513_eth_irq_pending(readl(eth->summary));
+}
+
+static int nt98513_eth_check_dt(struct platform_device *pdev)
+{
+	static const char * const names[] = {
+		"mac", "irq-summary", "inherited-top", "inherited-dgpio"
+	};
+	/* Deliberately narrow topology: generic C22 PHY scan, no child/reset,
+	 * fixed-link, queue, AXI, clock-rate, pinctrl or offload overrides.
+	 */
+	static const char * const allowed[] = {
+		"compatible", "reg", "reg-names", "interrupt-parent", "interrupts",
+		"interrupt-names", "clocks", "clock-names", "openipc,cc-bank",
+		"openipc,linux-exclusive-ownership", "phy-mode", "status",
+		"mac-address", "local-mac-address", "phandle", "linux,phandle", "name"
+	};
+	struct device_node *np = pdev->dev.of_node, *bank, *clock_bank;
+	struct of_phandle_args clock, irq;
+	struct nt98513_eth_input in = { 0 };
+	struct property *prop;
+	struct resource *res;
+	phy_interface_t mode;
+	unsigned int i;
+	int ret;
+
+	in.exclusive = of_property_read_bool(np, "openipc,linux-exclusive-ownership");
+	in.mode_ok = !of_get_phy_mode(np, &mode) &&
+		(mode == PHY_INTERFACE_MODE_MII || mode == PHY_INTERFACE_MODE_RMII);
+	in.irqs = of_irq_count(np);
+	in.unsupported = of_get_child_count(np) != 0 ||
+		of_property_count_strings(np, "compatible") != 1;
+	for_each_property_of_node(np, prop) {
+		for (i = 0; i < ARRAY_SIZE(allowed); i++)
+			if (!strcmp(prop->name, allowed[i]))
+				break;
+		if (i == ARRAY_SIZE(allowed))
+			in.unsupported = 1;
+	}
+	if (of_property_count_strings(np, "reg-names") != 4 ||
+	    of_property_count_strings(np, "interrupt-names") != 1 ||
+	    of_property_match_string(np, "interrupt-names", "macirq") != 0)
+		in.unsupported = 1;
+	for (i = 0; i < 4; i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res || !nt98513_eth_resource(i, res->start, resource_size(res)) ||
+		    strcmp(res->name, names[i]))
+			return -EINVAL;
+		in.resources++;
+	}
+	if (platform_get_resource(pdev, IORESOURCE_MEM, 4))
+		in.resources++;
+	ret = of_irq_parse_one(np, 0, &irq);
+	if (!ret) {
+		in.raw_irq_ok = irq.args_count == 1 && irq.args[0] == 34 &&
+			of_device_is_compatible(irq.np, "openipc,nt98513-intc");
+		of_node_put(irq.np);
+	}
+	ret = of_parse_phandle_with_args(np, "clocks", "#clock-cells", 0, &clock);
+	if (!ret) {
+		bank = of_parse_phandle(np, "openipc,cc-bank", 0);
+		clock_bank = of_parse_phandle(clock.np, "openipc,cc-bank", 0);
+		in.clock_ok = of_count_phandle_with_args(np, "clocks", "#clock-cells") == 1 &&
+			of_property_count_strings(np, "clock-names") == 1 &&
+			of_property_match_string(np, "clock-names", "stmmaceth") == 0 &&
+			clock.args_count == 1 && clock.args[0] == 1 &&
+			of_device_is_compatible(clock.np, "openipc,nt98513-shared-clock-v2") &&
+			bank && bank == clock_bank;
+		of_node_put(bank);
+		of_node_put(clock_bank);
+		of_node_put(clock.np);
+	}
+	return nt98513_eth_validate(&in);
+}
+
+static int nt98513_eth_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct plat_stmmacenet_data *plat;
+	struct stmmac_resources res;
+	struct nt98513_eth *eth;
+	int ret;
+
+	ret = nt98513_eth_check_dt(pdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "unqualified Ethernet board contract\n");
+	eth = devm_kzalloc(dev, sizeof(*eth), GFP_KERNEL);
+	if (!eth)
+		return -ENOMEM;
+	eth->dev = dev;
+	eth->bank = devm_nt98513_cc_bank_get(dev);
+	if (IS_ERR(eth->bank))
+		return PTR_ERR(eth->bank);
+	eth->clock = devm_clk_get(dev, "stmmaceth");
+	if (IS_ERR(eth->clock))
+		return PTR_ERR(eth->clock);
+	ret = stmmac_get_platform_resources(pdev, &res);
+	if (ret)
+		return ret;
+	eth->mac = res.addr;
+	eth->summary = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(eth->summary))
+		return PTR_ERR(eth->summary);
+	eth->top = devm_platform_ioremap_resource(pdev, 2);
+	if (IS_ERR(eth->top))
+		return PTR_ERR(eth->top);
+	eth->pads = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(eth->pads))
+		return PTR_ERR(eth->pads);
+	/* No MAC read, generic parser or core probe precedes checked activation. */
+	ret = nt98513_eth_activate(&nt98513_eth_ops, eth);
+	if (ret)
+		return dev_err_probe(dev, ret, "Ethernet inherited state or revision rejected\n");
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	plat = stmmac_probe_config_dt(pdev, res.mac);
+	if (IS_ERR(plat))
+		return PTR_ERR(plat);
+	plat->has_gmac = 0;
+	plat->has_gmac4 = 1;
+	plat->clk_csr = 1; /* recovered C22 encoding, not inferred from rate0 */
+	plat->unknown_csr_rate = true;
+	plat->irq_pending = nt98513_eth_pending;
+	plat->bsp_priv = eth;
+	plat->host_dma_width = 32;
+	plat->maxmtu = ETH_DATA_LEN;
+	plat->max_speed = SPEED_100;
+	plat->rx_queues_to_use = 1;
+	plat->tx_queues_to_use = 1;
+	plat->flags = STMMAC_FLAG_SPH_DISABLE;
+	plat->riwt_off = 1;
+	/* No reset sequence is established. MDIO's optional GPIO reset is off. */
+	plat->mdio_bus_data->needs_reset = false;
+	ret = nt98513_eth_fault(eth);
+	if (!ret)
+		ret = stmmac_pltfr_probe(pdev, plat, &res);
+	if (ret)
+		stmmac_remove_config_dt(pdev, plat);
+	return ret;
+}
+
+static const struct of_device_id nt98513_eth_match[] = {
+	{ .compatible = "openipc,nt98513-ethernet-v1" },
+	{ }
+};
+
+/* Builtin, permanent node: no user unbind, module unload, OF removal or PM. */
+static struct platform_driver nt98513_eth_driver = {
+	.probe = nt98513_eth_probe,
+	.driver = {
+		.name = "nt98513-ethernet",
+		.of_match_table = nt98513_eth_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(nt98513_eth_driver);
+MODULE_DESCRIPTION("Experimental NT98513 inherited-state DWMAC4");
+MODULE_LICENSE("GPL");
