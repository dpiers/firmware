+  compatible = "openipc,nt98513-shared-clock-v2";
+  reg = <0xc0020074 4>, <0xc0020084 4>;
+  reg-names = "gate", "prepare";
+  openipc,cc-bank = <&cc_bank>;
   #clock-cells = <1>;
  };
 };
