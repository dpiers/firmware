+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/soc/nt98513_cc_bank.h>
+#include "nt98513_cc_bank_core.h"
+struct nt98513_cc_bank {
+ struct device *dev;
+ void __iomem *regs;
+ struct mutex lock;
+ struct nt_cc_core core;
+ int cause_snapshot[2];
+ unsigned failure_snapshot[2];
+ unsigned snapshot; /* bit0 ready, bit1 sticky bank uncertainty */
+};
+static DEFINE_MUTEX(nt_cc_registry_lock);
+static struct device *nt_cc_reservation;
+static struct nt98513_cc_bank *nt_cc_singleton;
+static unsigned bank_grant(void *p) { return readl(((struct nt98513_cc_bank *)p)->regs + 8); }
+static void bank_write(void *p, enum nt_cc_reg reg, unsigned value)
+{
+ struct nt98513_cc_bank *b = p;
+ writel(value, b->regs + (reg == NT_CC_REQUEST ? 0 : 4));
+}
+static int bank_wait(void *p, unsigned mask, int set)
+{
+ struct nt98513_cc_bank *b = p;
+ u32 value;
+ /* Source polling policy, not a physical liveness or cancellation guarantee. */
+ return readl_poll_timeout(b->regs + 8, value, !!(value & mask) == !!set, 1, 1000);
+}
+static void bank_publish(struct nt98513_cc_bank *b)
+{
+ smp_store_release(&b->failure_snapshot[0], b->core.failure[0]);
+ smp_store_release(&b->failure_snapshot[1], b->core.failure[1]);
+ smp_store_release(&b->cause_snapshot[0], b->core.cause[0]);
+ smp_store_release(&b->cause_snapshot[1], b->core.cause[1]);
+ smp_store_release(&b->snapshot, 1u | (b->core.uncertain ? 2u : 0));
+}
+int nt_cc_status(struct nt98513_cc_bank *b)
+{
+ unsigned s = smp_load_acquire(&b->snapshot);
+ return !(s & 1) ? -EPROBE_DEFER : s & 2 ? -EIO : 0;
+}
+int nt_cc_failure_phase(struct nt98513_cc_bank *b, unsigned r)
+{
+ if (r != 2 && r != 4) return -EINVAL;
+ return smp_load_acquire(&b->failure_snapshot[r == 4]);
+}
+int nt_cc_cause(struct nt98513_cc_bank *b, unsigned r)
+{
+ if (r != 2 && r != 4) return -EINVAL;
+ return smp_load_acquire(&b->cause_snapshot[r == 4]);
+}
+int nt_cc_enter(struct nt98513_cc_bank *b, unsigned r)
+{
+ int error;
+ might_sleep();
+ if (r != 2 && r != 4) return -EINVAL;
+ mutex_lock(&b->lock);
+ error = nt_cc_status(b);
+ if (error == -EIO && nt_cc_core_cause(&b->core, r)) error = nt_cc_core_cause(&b->core, r);
+ if (!error) error = nt_cc_core_enter(&b->core, r);
+ if (error) mutex_unlock(&b->lock);
+ return error;
+}
+int nt_cc_acquire_locked(struct nt98513_cc_bank *b, unsigned r)
+{
+ const struct nt_cc_io io = { b, bank_grant, bank_write, bank_wait };
+ int error;
+ lockdep_assert_held(&b->lock);
+ error = nt_cc_core_acquire(&b->core, &io, r);
+ bank_publish(b);
+ return error;
+}
+int nt_cc_release_locked(struct nt98513_cc_bank *b, unsigned r)
+{
+ const struct nt_cc_io io = { b, bank_grant, bank_write, bank_wait };
+ int error;
+ lockdep_assert_held(&b->lock);
+ error = nt_cc_core_release(&b->core, &io, r);
+ bank_publish(b);
+ return error;
+}
+void nt_cc_leave(struct nt98513_cc_bank *b)
+{
+ lockdep_assert_held(&b->lock);
+ nt_cc_core_leave(&b->core);
+ bank_publish(b);
+ mutex_unlock(&b->lock);
+}
+static void nt_cc_put(void *p) { put_device(p); }
+struct nt98513_cc_bank *devm_nt98513_cc_bank_get(struct device *consumer)
+{
+ struct device_node *node;
+ struct nt98513_cc_bank *bank;
+ int error;
+ might_sleep();
+ if (of_property_count_u32_elems(consumer->of_node, "openipc,cc-bank") != 1) return ERR_PTR(-EINVAL);
+ node = of_parse_phandle(consumer->of_node, "openipc,cc-bank", 0);
+ if (!node || !of_device_is_available(node) ||
+     !of_device_is_compatible(node, "openipc,nt98513-cc-bank-v1")) {
+  of_node_put(node); return ERR_PTR(-EINVAL);
+ }
+ mutex_lock(&nt_cc_registry_lock);
+ bank = nt_cc_singleton;
+ error = !bank ? -EPROBE_DEFER : bank->dev->of_node != node ? -EINVAL : 0;
+ if (!error) get_device(bank->dev);
+ mutex_unlock(&nt_cc_registry_lock);
+ of_node_put(node);
+ if (error) return ERR_PTR(error);
+ error = devm_add_action_or_reset(consumer, nt_cc_put, bank->dev);
+ if (error) return ERR_PTR(error);
+ if (!device_link_add(consumer, bank->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+  devm_release_action(consumer, nt_cc_put, bank->dev); return ERR_PTR(-ENOMEM);
+ }
+ return bank;
+}
+static int nt_cc_probe(struct platform_device *pdev)
+{
+ struct resource *r;
+ struct nt98513_cc_bank *b;
+ int error = -EINVAL;
+ mutex_lock(&nt_cc_registry_lock);
+ if (nt_cc_reservation) { mutex_unlock(&nt_cc_registry_lock); return -EBUSY; }
+ nt_cc_reservation = &pdev->dev;
+ mutex_unlock(&nt_cc_registry_lock);
+ if (pdev->num_resources != 1) goto fail;
+ r = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+ if (!r || r->start != 0xc0090050 || resource_size(r) != 12) goto fail;
+ b = devm_kzalloc(&pdev->dev, sizeof(*b), GFP_KERNEL);
+ if (!b) { error = -ENOMEM; goto fail; }
+ b->dev = &pdev->dev;
+ mutex_init(&b->lock);
+ b->regs = devm_ioremap_resource(&pdev->dev, r);
+ if (IS_ERR(b->regs)) { error = PTR_ERR(b->regs); goto fail; }
+ platform_set_drvdata(pdev, b);
+ /* No I/O in probe, no fallible work or removal after publication. */
+ mutex_lock(&nt_cc_registry_lock);
+ bank_publish(b);
+ nt_cc_singleton = b;
+ mutex_unlock(&nt_cc_registry_lock);
+ return 0;
+fail:
+ mutex_lock(&nt_cc_registry_lock);
+ nt_cc_reservation = NULL;
+ mutex_unlock(&nt_cc_registry_lock);
+ return error;
+}
+static const struct of_device_id nt_cc_match[] = {
+ { .compatible = "openipc,nt98513-cc-bank-v1" }, { }
+};
+static struct platform_driver nt_cc_driver = {
+ .probe = nt_cc_probe,
+ .driver = { .name = "nt98513-cc-bank", .of_match_table = nt_cc_match, .suppress_bind_attrs = true },
+};
+static int __init nt_cc_init(void) { return platform_driver_register(&nt_cc_driver); }
+subsys_initcall(nt_cc_init);
