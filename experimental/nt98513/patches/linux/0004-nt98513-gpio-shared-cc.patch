+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef NT98513_CC_BANK_CORE_H
+#define NT98513_CC_BANK_CORE_H
+enum nt_cc_reg { NT_CC_REQUEST, NT_CC_RELEASE };
+enum nt_cc_phase { NT_CC_IDLE, NT_CC_REQUESTED, NT_CC_OWNED, NT_CC_RELEASED, NT_CC_UNCERTAIN };
+struct nt_cc_io {
+ void *context;
+ unsigned (*grant)(void *);
+ void (*write)(void *, enum nt_cc_reg, unsigned);
+ int (*wait)(void *, unsigned mask, int want_set);
+};
+/* One externally serialized bank; cause[] indexes resource2 then resource4. */
+enum nt_cc_failure { NT_CC_FAIL_NONE, NT_CC_FAIL_STALE, NT_CC_FAIL_ACQUIRE, NT_CC_FAIL_RELEASE, NT_CC_FAIL_ABANDONED, NT_CC_FAIL_PROTOCOL };
+struct nt_cc_core { int cause[2]; unsigned phase[2], failure[2], uncertain, active, acquired, attempted; };
+int nt_cc_core_cause(const struct nt_cc_core *, unsigned);
+int nt_cc_core_enter(struct nt_cc_core *, unsigned);
+int nt_cc_core_acquire(struct nt_cc_core *, const struct nt_cc_io *, unsigned);
+int nt_cc_core_release(struct nt_cc_core *, const struct nt_cc_io *, unsigned);
+void nt_cc_core_leave(struct nt_cc_core *);
+#endif
