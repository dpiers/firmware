+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/openipc,nt98513-shared-clock-v2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: NT98513 sticky clock owner using shared arbitration
+maintainers:
+  - Daniel Piers <dpiers@users.noreply.github.com>
+description: |
+  The supplier owns CC; this node owns only two CG words. Client1 is the
+  Ethernet activation clock; rate remains unknown. No disable/reset is exposed.
+properties:
+  compatible:
+    const: openipc,nt98513-shared-clock-v2
+  reg:
+    items:
+      - description: Gate C0020074, four bytes
+      - description: Preparation C0020084, four bytes
+  reg-names:
+    items:
+      - const: gate
+      - const: prepare
+  openipc,cc-bank:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Permanent core1 CC bank supplier
+  '#clock-cells':
+    const: 1
+required: [compatible, reg, reg-names, 'openipc,cc-bank', '#clock-cells']
+additionalProperties: false
