+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/gpio/openipc,nt98513-gpio.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: NT98513 sparse GPIO
+maintainers:
+  - Daniel Piers <dpiers@users.noreply.github.com>
+description: |
+  Chip offsets preserve logical IDs in a 256-offset space: 0-23,32-59,64-78,
+  96-119,128-135,160-171. Other offsets are invalid. IDs18-23 have observed
+  whole-word pad side effects; electrical meaning is not established. This
+  binding does not provide pinmux, interrupts, bias or hardware open-drain.
+properties:
+  compatible:
+    const: openipc,nt98513-gpio-v1
+  reg:
+    items:
+      - description: GPIO C0070000, 64KiB
+      - description: Pad control C0030070, four bytes
+      - description: Pad status C029001C, four bytes
+  reg-names:
+    items:
+      - const: gpio
+      - const: pad-control
+      - const: pad-status
+  openipc,cc-bank:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Permanent core1 CC bank supplier
+  gpio-controller: true
+  '#gpio-cells':
+    const: 2
+required: [compatible, reg, reg-names, 'openipc,cc-bank', gpio-controller, '#gpio-cells']
+additionalProperties: false
