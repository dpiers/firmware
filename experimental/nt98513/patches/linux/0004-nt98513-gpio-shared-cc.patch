+// SPDX-License-Identifier: GPL-2.0-only
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "nt98513_cc_bank_core.h"
+static int index_of(unsigned r) { return r == 2 ? 0 : r == 4 ? 1 : -1; }
+int nt_cc_core_cause(const struct nt_cc_core *s, unsigned r)
+{
+ int i = index_of(r);
+ return i < 0 ? -EINVAL : s->cause[i];
+}
+static int uncertain(struct nt_cc_core *s, unsigned r, int error, unsigned phase)
+{
+ int i = index_of(r);
+ if (i >= 0) {
+  if (!s->cause[i]) { s->cause[i] = error; s->failure[i] = phase; }
+  s->phase[i] = NT_CC_UNCERTAIN;
+ }
+ s->uncertain = 1;
+ return error;
+}
+int nt_cc_core_enter(struct nt_cc_core *s, unsigned r)
+{
+ int i = index_of(r);
+ if (i < 0) return -EINVAL;
+ if (s->cause[i]) return s->cause[i];
+ if (s->uncertain) return -EIO;
+ if (s->active) return -EBUSY;
+ s->active = r;
+ s->acquired = 0;
+ s->attempted = 0;
+ return 0;
+}
+int nt_cc_core_acquire(struct nt_cc_core *s, const struct nt_cc_io *io, unsigned r)
+{
+ int error, i = index_of(r);
+ if (i < 0 || s->active != r) return -EINVAL;
+ if (s->uncertain) return s->cause[i] ? s->cause[i] : -EIO;
+ if (s->attempted) return uncertain(s, r, -EIO, NT_CC_FAIL_PROTOCOL);
+ s->attempted = 1;
+ if (io->grant(io->context) & (1u << r)) return uncertain(s, r, -EIO, NT_CC_FAIL_STALE);
+ s->phase[i] = NT_CC_REQUESTED;
+ io->write(io->context, NT_CC_REQUEST, 1u << r);
+ error = io->wait(io->context, 1u << r, 1);
+ /* No timeout release: the hardware cancellation contract is unknown. */
+ if (error) return uncertain(s, r, error, NT_CC_FAIL_ACQUIRE);
+ s->acquired = 1;
+ s->phase[i] = NT_CC_OWNED;
+ return 0;
+}
+int nt_cc_core_release(struct nt_cc_core *s, const struct nt_cc_io *io, unsigned r)
+{
+ int error, i = index_of(r);
+ if (i < 0 || s->active != r) return -EINVAL;
+ if (s->uncertain) return s->cause[i] ? s->cause[i] : -EIO;
+ if (!s->acquired) return uncertain(s, r, -EIO, NT_CC_FAIL_PROTOCOL);
+ io->write(io->context, NT_CC_RELEASE, 1u << r);
+ error = io->wait(io->context, 1u << r, 0);
+ s->acquired = 0;
+ if (error) return uncertain(s, r, error, NT_CC_FAIL_RELEASE);
+ s->phase[i] = NT_CC_RELEASED;
+ return 0;
+}
+void nt_cc_core_leave(struct nt_cc_core *s)
+{
+ if (s->acquired) uncertain(s, s->active, -EIO, NT_CC_FAIL_ABANDONED);
+ s->active = 0;
+ s->acquired = 0;
+}
