+ };
+ gpio: gpio@c0070000 {
+  compatible = "openipc,nt98513-gpio-v1";
+  reg = <0xc0070000 0x10000>, <0xc0030070 4>, <0xc029001c 4>;
+  reg-names = "gpio", "pad-control", "pad-status";
+  openipc,cc-bank = <&cc_bank>;
+  gpio-controller;
+  #gpio-cells = <2>;
