+                     const struct nt98513_gpio_ops *ops, void *context)
+{
+ if (!g || !ops || !ops->read || !ops->write || !ops->bank_status ||
+     !ops->acquire4 || !ops->release4) return -EINVAL;
+ g->ops = ops;
+ g->context = context;
+ g->fault = 0;
+ return 0;
+}
+static int admit(struct nt98513_gpio *g, unsigned pin)
+{
+ if (!nt98513_gpio_valid(pin) || !g || !g->ops) return -EINVAL;
+ if (g->fault) return g->fault;
+ return g->ops->bank_status(g->context);
+}
+static int local_result(struct nt98513_gpio *g, int error)
+{
+ if (error && !g->fault) g->fault = error;
+ return error;
+}
+static int read_reg(struct nt98513_gpio *g, enum nt_gpio_space space,
+                    unsigned offset, nt_gpio_u32 *value)
+{
+ return local_result(g, g->ops->read(g->context, space, offset, value));
+}
+static int write_reg(struct nt98513_gpio *g, enum nt_gpio_space space,
+                     unsigned offset, nt_gpio_u32 value)
+{
+ return local_result(g, g->ops->write(g->context, space, offset, value));
+}
+static int pad(struct nt98513_gpio *g, unsigned pin)
+{
+ nt_gpio_u32 control, status;
+ int error = read_reg(g, NT_GPIO_PAD_CONTROL, 0, &control);
+ if (error) return error;
+ /* The second read is retained even for pins outside 18..23. */
+ error = read_reg(g, NT_GPIO_PAD_STATUS, 0, &status);
+ if (error || pin < 18 || pin > 23) return error;
+ if (!(status & 0x10) && (control & 1))
+  return write_reg(g, NT_GPIO_PAD_CONTROL, 0, 0x10);
+ if ((status & 0x10) && !(control & 1))
+  return write_reg(g, NT_GPIO_PAD_CONTROL, 0, 0x11);
+ return 0;
+}
+static int value_store(struct nt98513_gpio *g, unsigned pin, int value)
+{
+ return write_reg(g, NT_GPIO_REGS, (value ? 0x40 : 0x60) + 4 * (pin / 32),
+                  (nt_gpio_u32)1 << (pin % 32));
+}
+int nt98513_gpio_get(struct nt98513_gpio *g, unsigned pin)
+{
+ nt_gpio_u32 value;
+ int error = admit(g, pin);
+ if (!error) error = pad(g, pin);
+ if (!error) error = read_reg(g, NT_GPIO_REGS, 4 * (pin / 32), &value);
+ return error ? error : !!(value & ((nt_gpio_u32)1 << (pin % 32)));
+}
+int nt98513_gpio_set(struct nt98513_gpio *g, unsigned pin, int value)
+{
+ int error = admit(g, pin);
+ if (!error) error = pad(g, pin);
+ if (!error) error = value_store(g, pin, value);
+ /* No input-level readback claims an output-latch acknowledgement. */
+ return error;
+}
+int nt98513_gpio_get_direction(struct nt98513_gpio *g, unsigned pin)
+{
+ nt_gpio_u32 value;
+ int error = admit(g, pin);
+ if (!error) error = read_reg(g, NT_GPIO_REGS, 0x20 + 4 * (pin / 32), &value);
+ return error ? error : !(value & ((nt_gpio_u32)1 << (pin % 32)));
+}
+static int direction(struct nt98513_gpio *g, unsigned pin, int output, int value)
+{
+ nt_gpio_u32 old, bit = (nt_gpio_u32)1 << (pin % 32);
+ int release_error, error = admit(g, pin);
+ if (!error) error = pad(g, pin);
+ if (error) return error;
+ error = g->ops->acquire4(g->context);
+ if (error) return error; /* Pad effects may already have occurred. */
+ error = read_reg(g, NT_GPIO_REGS, 0x20 + 4 * (pin / 32), &old);
+ if (!error) error = write_reg(g, NT_GPIO_REGS, 0x20 + 4 * (pin / 32),
+                               output ? old | bit : old & ~bit);
+ /* A known successful acquisition is released once even after local I/O failure. */
+ release_error = g->ops->release4(g->context);
+ if (error) return error;
+ if (release_error) return release_error;
+ /* Failure to observe release suppresses this write, without undoing direction. */
+ return output ? value_store(g, pin, value) : 0;
+}
+int nt98513_gpio_direction_input(struct nt98513_gpio *g, unsigned pin)
+{
+ return direction(g, pin, 0, 0);
+}
+int nt98513_gpio_direction_output(struct nt98513_gpio *g, unsigned pin, int value)
+{
+ return direction(g, pin, 1, value);
+}
