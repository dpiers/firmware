+$id: http://devicetree.org/schemas/soc/openipc,nt98513-cc-bank.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+title: NT98513 core1 cross-core request bank
+maintainers:
+  - Daniel Piers <dpiers@users.noreply.github.com>
+description: |
+  One permanent supplier owns the request/release/grant words. Resource2 and
+  resource4 are serialized locally. Timeout cancellation and reset are unknown.
+properties:
+  compatible:
+    const: openipc,nt98513-cc-bank-v1
+  reg:
+    maxItems: 1
+required: [compatible, reg]
+additionalProperties: false
