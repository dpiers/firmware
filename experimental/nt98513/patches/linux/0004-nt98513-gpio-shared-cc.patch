+#include <linux/bitmap.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/driver.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+#include <linux/soc/nt98513_cc_bank.h>
+#include "nt98513_gpio_core.h"
+
+enum nt_gpio_phase { NT_GPIO_FAILED, NT_GPIO_REGISTERING, NT_GPIO_READY };
+struct nt_gpio_device {
+ struct gpio_chip chip;
+ struct device *dev;
+ struct mutex lock;
+ struct nt98513_cc_bank *bank;
+ struct nt98513_gpio core;
+ void __iomem *regs, *pad_control, *pad_status;
+ enum nt_gpio_phase phase;
+ int registration_error, local_fault, set_error;
+};
+static int nt_gpio_read(void *context, enum nt_gpio_space space,
+                        unsigned offset, nt_gpio_u32 *value)
+{
+ struct nt_gpio_device *g = context;
+ void __iomem *base = space == NT_GPIO_REGS ? g->regs :
+                      space == NT_GPIO_PAD_CONTROL ? g->pad_control : g->pad_status;
+ *value = readl(base + offset);
+ return 0;
+}
+static int nt_gpio_write(void *context, enum nt_gpio_space space,
+                         unsigned offset, nt_gpio_u32 value)
+{
+ struct nt_gpio_device *g = context;
+ void __iomem *base = space == NT_GPIO_REGS ? g->regs : g->pad_control;
+ writel(value, base + offset);
+ return 0;
+}
+static int nt_gpio_bank_status(void *p) { return nt_cc_status(((struct nt_gpio_device *)p)->bank); }
+static int nt_gpio_acquire4(void *p) { return nt_cc_acquire_locked(((struct nt_gpio_device *)p)->bank, 4); }
+static int nt_gpio_release4(void *p) { return nt_cc_release_locked(((struct nt_gpio_device *)p)->bank, 4); }
+static const struct nt98513_gpio_ops nt_gpio_ops = {
+ .read = nt_gpio_read, .write = nt_gpio_write, .bank_status = nt_gpio_bank_status,
+ .acquire4 = nt_gpio_acquire4, .release4 = nt_gpio_release4,
+};
+static void nt_registration_error(struct nt_gpio_device *g, int error)
+{
+ if (g->phase == NT_GPIO_REGISTERING && !g->registration_error)
+  WRITE_ONCE(g->registration_error, error);
+}
+/* Successful return retains exactly GPIO then bank mutexes. */
+static int nt_gpio_begin(struct nt_gpio_device *g, unsigned pin, bool direction_query)
+{
+ int error;
+ if (!nt98513_gpio_valid(pin)) return -EINVAL;
+ mutex_lock(&g->lock);
+ if (g->phase == NT_GPIO_REGISTERING && !direction_query) error = -EAGAIN;
+ else if (g->phase != NT_GPIO_READY && g->phase != NT_GPIO_REGISTERING) error = -ENODEV;
+ else if (g->core.fault) error = g->core.fault;
+ else {
+  error = nt_cc_enter(g->bank, 4);
+  if (!error) return 0;
+ }
+ if (direction_query && error != -EAGAIN) nt_registration_error(g, error);
+ mutex_unlock(&g->lock);
+ return error;
+}
+static void nt_gpio_end(struct nt_gpio_device *g)
+{
+ WRITE_ONCE(g->local_fault, g->core.fault);
+ nt_cc_leave(g->bank);
+ mutex_unlock(&g->lock);
+}
+static int nt_gpio_request(struct gpio_chip *chip, unsigned pin)
+{
+ struct nt_gpio_device *g = gpiochip_get_data(chip);
+ int error = nt_gpio_begin(g, pin, false);
+ if (!error) nt_gpio_end(g);
+ return error;
+}
+static int nt_gpio_get(struct gpio_chip *chip, unsigned pin)
+{
+ struct nt_gpio_device *g = gpiochip_get_data(chip);
+ int error = nt_gpio_begin(g, pin, false);
+ if (error) return error;
+ error = nt98513_gpio_get(&g->core, pin);
+ nt_gpio_end(g);
+ return error;
+}
+static void nt_gpio_set(struct gpio_chip *chip, unsigned pin, int value)
+{
+ struct nt_gpio_device *g = gpiochip_get_data(chip);
+ int error = nt_gpio_begin(g, pin, false);
+ if (!error) {
+  error = nt98513_gpio_set(&g->core, pin, value);
+  nt_gpio_end(g);
+ }
+ /* An expected early/invalid call is not a hardware or registration fault. */
+ if (error && error != -EAGAIN && error != -EINVAL) {
+  mutex_lock(&g->lock);
+  if (!g->set_error) WRITE_ONCE(g->set_error, error);
+  mutex_unlock(&g->lock);
+  dev_err_ratelimited(g->dev, "GPIO set refused: %d; void callback cannot acknowledge delivery\n", error);
+ }
+}
+static int nt_gpio_get_direction(struct gpio_chip *chip, unsigned pin)
+{
+ struct nt_gpio_device *g = gpiochip_get_data(chip);
+ int error = nt_gpio_begin(g, pin, true);
+ if (error) return error;
+ error = nt98513_gpio_get_direction(&g->core, pin);
+ if (error < 0) nt_registration_error(g, error);
+ nt_gpio_end(g);
+ return error;
+}
+static int nt_gpio_input(struct gpio_chip *chip, unsigned pin)
+{
+ struct nt_gpio_device *g = gpiochip_get_data(chip);
+ int error = nt_gpio_begin(g, pin, false);
+ if (error) return error;
+ error = nt98513_gpio_direction_input(&g->core, pin);
+ nt_gpio_end(g);
+ return error;
+}
+static int nt_gpio_output(struct gpio_chip *chip, unsigned pin, int value)
+{
+ struct nt_gpio_device *g = gpiochip_get_data(chip);
+ int error = nt_gpio_begin(g, pin, false);
+ if (error) return error;
+ error = nt98513_gpio_direction_output(&g->core, pin, value);
+ nt_gpio_end(g);
+ return error;
+}
+static int nt_gpio_set_config(struct gpio_chip *chip, unsigned pin, unsigned long config)
+{
+ (void)chip; (void)config;
+ return nt98513_gpio_valid(pin) ? -ENOTSUPP : -EINVAL;
+}
+static int nt_gpio_valid_mask(struct gpio_chip *chip, unsigned long *mask, unsigned ngpio)
+{
+ unsigned pin;
+ (void)chip;
+ if (ngpio != 256) return -EINVAL;
+ bitmap_zero(mask, ngpio);
+ for (pin = 0; pin < ngpio; pin++) if (nt98513_gpio_valid(pin)) __set_bit(pin, mask);
+ return 0;
+}
+static ssize_t fault_status_show(struct device *dev, struct device_attribute *attribute, char *buf)
+{
+ struct nt_gpio_device *g = dev_get_drvdata(dev);
+ (void)attribute;
+ return sysfs_emit(buf, "bank=%d cc2=%d cc2_phase=%d cc4=%d cc4_phase=%d gpio=%d set=%d registration=%d phase=%d\n",
+                   nt_cc_status(g->bank), nt_cc_cause(g->bank, 2), nt_cc_failure_phase(g->bank, 2),
+                   nt_cc_cause(g->bank, 4), nt_cc_failure_phase(g->bank, 4),
+                   READ_ONCE(g->local_fault), READ_ONCE(g->set_error),
+                   READ_ONCE(g->registration_error), READ_ONCE(g->phase));
+}
+static DEVICE_ATTR_RO(fault_status);
+static int nt_gpio_probe(struct platform_device *pdev)
+{
+ static const char * const names[] = { "gpio", "pad-control", "pad-status" };
+ static const resource_size_t starts[] = { 0xc0070000, 0xc0030070, 0xc029001c };
+ static const resource_size_t sizes[] = { 0x10000, 4, 4 };
+ struct device *dev = &pdev->dev;
+ struct nt_gpio_device *g;
+ struct resource *resources[3];
+ void __iomem *maps[3];
+ u32 cells;
+ unsigned i;
+ int error, bank_error;
+ if (pdev->num_resources != 3 || !dev->of_node ||
+     !of_property_read_bool(dev->of_node, "gpio-controller") || of_property_read_u32(dev->of_node, "#gpio-cells", &cells) || cells != 2 ||
+     of_get_available_child_count(dev->of_node) || platform_get_resource(pdev, IORESOURCE_MEM, 3)) return -EINVAL;
+ for (i = 0; i < 3; i++) {
+  resources[i] = platform_get_resource_byname(pdev, IORESOURCE_MEM, names[i]);
+  if (!resources[i] || resources[i]->start != starts[i] || resource_size(resources[i]) != sizes[i]) return -EINVAL;
+ }
+ g = devm_kzalloc(dev, sizeof(*g), GFP_KERNEL);
+ if (!g) return -ENOMEM;
+ g->dev = dev;
+ mutex_init(&g->lock);
+ for (i = 0; i < 3; i++) {
+  maps[i] = devm_ioremap_resource(dev, resources[i]);
+  if (IS_ERR(maps[i])) return PTR_ERR(maps[i]);
+ }
+ g->regs = maps[0]; g->pad_control = maps[1]; g->pad_status = maps[2];
+ g->bank = devm_nt98513_cc_bank_get(dev);
+ if (IS_ERR(g->bank)) return PTR_ERR(g->bank);
+ error = nt98513_gpio_init(&g->core, &nt_gpio_ops, g);
+ if (error) return error;
+ /* Read-only admission; never request a CC bit or touch a pad during probe. */
+ error = nt_cc_enter(g->bank, 4);
+ if (error) return error;
+ nt_cc_leave(g->bank);
+ platform_set_drvdata(pdev, g);
+ error = device_create_file(dev, &dev_attr_fault_status);
+ if (error) return error;
+ g->chip = (struct gpio_chip) {
+  .label = dev_name(dev), .parent = dev, .owner = THIS_MODULE,
+  .base = -1, .ngpio = 256, .can_sleep = true,
+  .request = nt_gpio_request, .get = nt_gpio_get, .set = nt_gpio_set,
+  .get_direction = nt_gpio_get_direction, .direction_input = nt_gpio_input,
+  .direction_output = nt_gpio_output, .set_config = nt_gpio_set_config,
+  .init_valid_mask = nt_gpio_valid_mask,
+ };
+ WRITE_ONCE(g->phase, NT_GPIO_REGISTERING);
+ /* gpiolib performs callbacks and its own failure unwind: no consumer lock held. */
+ error = gpiochip_add_data(&g->chip, g);
+ if (error) {
+  mutex_lock(&g->lock);
+  WRITE_ONCE(g->phase, NT_GPIO_FAILED);
+  mutex_unlock(&g->lock);
+  device_remove_file(dev, &dev_attr_fault_status);
+  return error;
+ }
+ mutex_lock(&g->lock);
+ bank_error = nt_cc_enter(g->bank, 4);
+ error = g->registration_error ? g->registration_error : bank_error;
+ if (!error) error = g->core.fault;
+ if (error) {
+  nt_registration_error(g, error);
+  WRITE_ONCE(g->phase, NT_GPIO_FAILED);
+ } else WRITE_ONCE(g->phase, NT_GPIO_READY);
+ if (!bank_error) nt_cc_leave(g->bank);
+ mutex_unlock(&g->lock);
+ if (error) {
+  /* chip removal must finish synchronous callbacks before devm releases mappings. */
+  gpiochip_remove(&g->chip);
+  device_remove_file(dev, &dev_attr_fault_status);
+ }
+ return error;
+}
+static const struct of_device_id nt_gpio_match[] = {
+ { .compatible = "openipc,nt98513-gpio-v1" }, { }
+};
+MODULE_DEVICE_TABLE(of, nt_gpio_match);
+static struct platform_driver nt_gpio_driver = {
+ .probe = nt_gpio_probe,
+ .driver = { .name = "nt98513-gpio", .of_match_table = nt_gpio_match, .suppress_bind_attrs = true },
+};
+builtin_platform_driver(nt_gpio_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("NT98513 GPIO with shared CC-bank admission");
